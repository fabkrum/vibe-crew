---
import DocsLayout from '../layouts/DocsLayout.astro';
import I18nPatternIllustration from '../components/patterns/I18nPatternIllustration.astro';
import { i18nPatterns, categoryLabels, categoryOrder } from '../data/i18n-patterns';
import type { I18nPattern } from '../data/i18n-patterns';

// Group patterns by category
const grouped = categoryOrder.reduce((acc, cat) => {
  const items = i18nPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof i18nPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<I18nPattern['category'], string> = {
  text: 'Handling text content across languages — expansion, contraction, pluralization rules, and string formatting that goes beyond simple translation.',
  names: 'Personal identity fields that vary across cultures — name structures, phone numbers, and identity formats that break the Western-centric assumptions.',
  addresses: 'Physical address formats that change dramatically by country — field order, required fields, postal code formats, and administrative divisions.',
  formatting: 'Numbers, dates, and currencies that look different in every locale — separators, symbol positions, decimal precision, and calendar conventions.',
  rtl: 'Right-to-left language support for Arabic, Hebrew, and Farsi — layout mirroring, CSS logical properties, and bidirectional text handling.',
  testing: 'Testing and QA patterns for internationalized applications — locale switching, pseudo-localization, and validation across locales.',
};
---

<DocsLayout title="i18n Guide" sectionLabel="Reference" activeSlug="i18n-guide">

  <h2>i18n Guide</h2>
  <p>Internationalization patterns that VibeCrew agents apply during planning, design, and code review. Every pattern addresses a specific pitfall that breaks applications in non-English locales, with concrete implementation guidance using browser-native APIs.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()]/g, '-')}>
            <div class="pattern-card-inner">
              <I18nPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Pitfall</span>
                    <p>{entry.pitfall}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &#x2192;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Work in German"</td><td>Intl.NumberFormat + Intl.DateTimeFormat + Dynamic Address Form</td></tr>
        <tr><td>"Support Arabic"</td><td>RTL Layout (dir="rtl" + CSS logical properties + mirrored layout)</td></tr>
        <tr><td>"Name field"</td><td>Single Full Name Field (not first/last split)</td></tr>
        <tr><td>"Show prices in euros"</td><td>Intl.NumberFormat with style: "currency" + locale formatting</td></tr>
        <tr><td>"Multi-language"</td><td>Locale Switcher + String Externalization + Text Expansion Buffer</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Pages</h3>
    <ul class="related-links">
      <li><a href="/form-patterns">Form Patterns</a> &mdash; Form structure, validation, and autocomplete that work across locales</li>
      <li><a href="/legal-compliance">Legal & Compliance</a> &mdash; Privacy policy and cookie consent requirements for international sites</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://www.w3.org/International/questions/qa-personal-names" target="_blank" rel="noopener noreferrer">W3C Personal Names Around the World</a> &mdash; Why splitting names into first/last fails across cultures</li>
      <li><a href="https://www.w3.org/International/wiki/Address_Formats" target="_blank" rel="noopener noreferrer">W3C International Address Formats</a> &mdash; Country-specific address field layouts and postal conventions</li>
      <li><a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl" target="_blank" rel="noopener noreferrer">MDN Intl</a> &mdash; Browser-native internationalization APIs for numbers, dates, currencies, and pluralization</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .category-nav a {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .category-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .category-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    margin-top: 2rem;
  }

  .category-description {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .pattern-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .pattern-card {
    padding: 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    overflow: hidden;
  }

  .pattern-card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .pattern-content {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .pattern-card-inner {
      flex-direction: column;
    }
  }

  .pattern-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .pattern-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .pattern-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-block {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-block p {
    margin: 0;
    color: var(--color-text-secondary);
    overflow-wrap: break-word;
  }

  .meta-label {
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-right: 0.35rem;
  }

  .docs-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .docs-link:hover {
    text-decoration: underline;
  }

  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }

  .further-reading {
    margin-top: 3rem;
  }

  .further-reading ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .further-reading li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .further-reading li:last-child {
    border-bottom: none;
  }

  .further-reading a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .further-reading a:hover {
    text-decoration: underline;
  }
</style>
