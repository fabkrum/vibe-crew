---
import DocsLayout from '../layouts/DocsLayout.astro';
import BusinessPatternIllustration from '../components/patterns/BusinessPatternIllustration.astro';
import { businessPatterns, categoryLabels, categoryOrder } from '../data/business-patterns';
import type { BusinessPattern } from '../data/business-patterns';

// Group patterns by category
const grouped = categoryOrder.reduce((acc, cat) => {
  const items = businessPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof businessPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<BusinessPattern['category'], string> = {
  landing: 'Hero sections, social proof, CTA hierarchy, pricing psychology, and above-the-fold frameworks for pages that convert.',
  onboarding: 'First-run experiences, activation moments, progressive profiling, and contextual help that get users to value fast.',
  trust: 'Social proof placement, risk reversal, security indicators, and transparency patterns that reduce anxiety at commitment points.',
  pricing: 'Three-tier structures, decoy effects, recommended tier highlighting, and billing toggles that guide plan selection.',
  'empty-states': 'Value explanations, guided first actions, and sample data that turn blank screens into onboarding moments.',
  retention: 'Habit loops, progress mechanics, re-engagement patterns, and variable rewards that bring users back.',
  navigation: 'Item limits, trunk tests, F-pattern scanning, and persistent navigation for effortless wayfinding.',
  feedback: 'Peak-End Rule, success celebrations, next-step suggestions, and progress indicators that make completion feel great.',
};
---

<DocsLayout title="Business Patterns" sectionLabel="Reference" activeSlug="business-patterns">

  <h2>Business Success Patterns</h2>
  <p>Research-backed conversion, trust, and engagement patterns that VibeCrew agents apply automatically during design and code review. Each pattern includes the reasoning so you understand <em>why</em> it works, not just what to do.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()]/g, '-')}>
            <div class="pattern-card-inner">
              <BusinessPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Why it works</span>
                    <p>{entry.whyItWorks}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Example</span>
                    <p>{entry.example}</p>
                  </div>
                  {entry.source && (
                    <span class="source-badge">{entry.source}</span>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Sources & Further Reading</h3>
    <ul>
      <li><a href="https://baymard.com/research" target="_blank" rel="noopener noreferrer">Baymard Institute</a> &mdash; E-commerce and checkout UX research (benchmark studies)</li>
      <li><a href="https://www.nngroup.com/articles/" target="_blank" rel="noopener noreferrer">Nielsen Norman Group</a> &mdash; Evidence-based UX research and guidelines</li>
      <li><a href="https://cxl.com/blog/" target="_blank" rel="noopener noreferrer">CXL Institute</a> &mdash; Conversion optimization research and case studies</li>
      <li><a href="https://sensible.com/dont-make-me-think/" target="_blank" rel="noopener noreferrer">Don't Make Me Think</a> &mdash; Steve Krug's foundational usability guide</li>
      <li><a href="https://behaviormodel.org/" target="_blank" rel="noopener noreferrer">Fogg Behavior Model</a> &mdash; B.J. Fogg's framework: Behavior = Motivation + Ability + Prompt</li>
      <li><a href="https://buildastorybrand.com/" target="_blank" rel="noopener noreferrer">StoryBrand</a> &mdash; Donald Miller's framework for clear brand messaging</li>
      <li><a href="https://unbounce.com/landing-page-articles/" target="_blank" rel="noopener noreferrer">Unbounce</a> &mdash; Landing page and form optimization data</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .category-nav a {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .category-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .category-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    margin-top: 2rem;
  }

  .category-description {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .pattern-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .pattern-card {
    padding: 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .pattern-card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .pattern-content {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .pattern-card-inner {
      flex-direction: column;
    }
  }

  .pattern-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .pattern-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .pattern-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-block {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-block p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .meta-label {
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-right: 0.35rem;
  }

  .source-badge {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    font-family: var(--font-mono);
    background: var(--color-accent-bg);
    color: var(--color-accent);
    border-radius: var(--radius-xs);
    letter-spacing: 0.02em;
  }

  .further-reading {
    margin-top: 3rem;
  }

  .further-reading ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .further-reading li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .further-reading li:last-child {
    border-bottom: none;
  }

  .further-reading a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .further-reading a:hover {
    text-decoration: underline;
  }
</style>
