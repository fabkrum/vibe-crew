---
import HomeLayout from '../layouts/HomeLayout.astro';
import { SITE_VERSION, SITE_TITLE, SITE_DESCRIPTION, url } from '../data/site';
---

<HomeLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <header class="hero">
    <div class="hero-badge">Claude Code Plugin &middot; {SITE_VERSION}</div>
    <h1>VibeCrew Documentation</h1>
    <p>The autonomous vibe-coding operating system that turns Claude Code into a full development team. Architecture-first, attention-aware, and self-improving.</p>
    <div class="hero-actions">
      <a href={url('/quick-start.html')} class="hero-btn primary">Quick Start &rarr;</a>
      <a href={url('/setup.html')} class="hero-btn secondary">Full Setup Guide</a>
    </div>
  </header>

  <div class="main" data-pagefind-body>
    <div class="page-grid">
      <a href={url('/why.html')} class="page-card">
        <div class="page-card-icon purple">&#9733;</div>
        <h3>Why VibeCrew</h3>
        <p>The three problems VibeCrew solves: the attention bottleneck, token waste, and code without architecture. Core design philosophy and principles.</p>
        <div class="card-arrow">Read more &rarr;</div>
      </a>

      <a href={url('/setup.html')} class="page-card">
        <div class="page-card-icon green">&#9881;</div>
        <h3>Setup Guide</h3>
        <p>Step-by-step installation from zero: system dependencies, plugin setup, MCP servers, Warp Terminal configuration, and notification testing.</p>
        <div class="card-arrow">Get started &rarr;</div>
      </a>

      <a href={url('/new-project.html')} class="page-card">
        <div class="page-card-icon blue">&#10010;</div>
        <h3>Start a New Project</h3>
        <p>The Two-Tier Workflow: build the project foundation (VISION.md, design system, TDR, roadmap, CLAUDE.md), then enter the 6-phase feature cycle.</p>
        <div class="card-arrow">Read more &rarr;</div>
      </a>

      <a href={url('/existing-project.html')} class="page-card">
        <div class="page-card-icon amber">&#8635;</div>
        <h3>Existing Projects</h3>
        <p>Bring VibeCrew into an existing codebase: automated code auditing, convention extraction, design system derivation, and backlog mapping.</p>
        <div class="card-arrow">Read more &rarr;</div>
      </a>

      <a href={url('/workflow.html')} class="page-card">
        <div class="page-card-icon red">&#9654;</div>
        <h3>Core Workflow</h3>
        <p>The two-tier development lifecycle, 6-phase feature cycle, Vibe Score system, plus advanced features, personalization, and efficiency tips.</p>
        <div class="card-arrow">Read more &rarr;</div>
      </a>

      <a href={url('/dashboard.html')} class="page-card">
        <div class="page-card-icon blue">&#9636;</div>
        <h3>Vibe Dashboard</h3>
        <p>Browse your project metrics in the browser: feature Kanban, session stats, Vibe Score trends, test coverage, achievements, and settings.</p>
        <div class="card-arrow">Learn more &rarr;</div>
      </a>

      <a href={url('/example-session.html')} class="page-card">
        <div class="page-card-icon red">&#9654;</div>
        <h3>Example Session</h3>
        <p>A concrete walkthrough: terminal setup, Day 1 foundation, planning sessions, building features, multi-tab workflows, capturing ideas, and a full week timeline.</p>
        <div class="card-arrow">See the example &rarr;</div>
      </a>

      <a href={url('/architecture.html')} class="page-card">
        <div class="page-card-icon purple">&#9632;</div>
        <h3>Architecture Deep Dive</h3>
        <p>The 14-agent system, hook enforcement layer, status bar, interrupt protocol, phase gate, Vibe Score, slash commands, state management, and Vibe Dashboard.</p>
        <div class="card-arrow">Read more &rarr;</div>
      </a>

      <a href={url('/warp.html')} class="page-card">
        <div class="page-card-icon blue">&#9000;</div>
        <h3>Warp Tips &amp; Tricks</h3>
        <p>Optimize your Warp Terminal for VibeCrew: window layouts, Launch Configurations, keyboard shortcuts, Warp Drive, Notebooks, themes, and more.</p>
        <div class="card-arrow">Explore tips &rarr;</div>
      </a>

      <a href={url('/releases.html')} class="page-card">
        <div class="page-card-icon green">&#9998;</div>
        <h3>Release Notes</h3>
        <p>Complete changelog for all VibeCrew versions: v1.0.0 through {SITE_VERSION}. Every new feature, agent, script, and configuration change documented.</p>
        <div class="card-arrow">View changelog &rarr;</div>
      </a>
    </div>
  </div>
</HomeLayout>

<!-- Global copy button handler -->
<script is:inline>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.copy-btn');
    if (!btn) return;
    var pre = btn.closest('pre');
    var text = pre && pre.getAttribute('data-copy');
    if (!text) {
      var code = pre && pre.querySelector('code');
      if (code) text = code.textContent;
    }
    if (text) {
      navigator.clipboard.writeText(text).then(function() {
        btn.classList.add('copied');
        setTimeout(function() { btn.classList.remove('copied'); }, 2000);
      });
    }
  });

  // Auto-inject copy buttons on any pre without one
  document.querySelectorAll('pre:not(:has(.copy-btn))').forEach(function(pre) {
    if (pre.classList.contains('mermaid')) return;
    var btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copy to clipboard');
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    pre.style.position = 'relative';
    pre.appendChild(btn);
  });
</script>
