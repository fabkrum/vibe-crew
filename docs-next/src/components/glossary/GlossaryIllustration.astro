---
import { agentSvgs } from './agent-svgs';
import { workflowSvgs } from './workflow-svgs';
import { toolSvgs } from './tool-svgs';
import { designSvgs } from './design-svgs';

interface Props {
  name: string;
}

const { name } = Astro.props;

const allSvgs: Record<string, string> = {
  ...agentSvgs,
  ...workflowSvgs,
  ...toolSvgs,
  ...designSvgs,
};

const svg = allSvgs[name];
---

{svg && (
  <div class="glossary-illustration" set:html={svg} />
)}

<style>
  .glossary-illustration {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
  }

  .glossary-illustration :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
