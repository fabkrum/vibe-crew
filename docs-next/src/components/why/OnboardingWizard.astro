---
import { url } from '../../data/site';
---

<div class="ob-wizard" id="ob-wizard">
  <!-- ── Wizard (questions) ──────────────────────────────── -->
  <div id="ob-questions">
    <div class="ob-header">
      <h2 class="ob-title">What do you want to build today?</h2>
      <p class="ob-subtitle">Answer 3 questions and get started in minutes with your personal setup guide.</p>
    </div>

    <div class="ob-progress" id="ob-progress">
      <span class="ob-dot active" data-dot="1"></span>
      <span class="ob-dot" data-dot="2"></span>
      <span class="ob-dot" data-dot="3"></span>
    </div>

    <div class="ob-step" data-step="1">
      <p class="ob-question">Are you starting fresh or adding to an existing project?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="project" data-value="new">
          <span class="ob-btn-icon">&#10010;</span>
          New project
        </button>
        <button class="ob-btn" data-key="project" data-value="existing">
          <span class="ob-btn-icon">&#8599;</span>
          Existing project
        </button>
      </div>
    </div>

    <div class="ob-step hidden" data-step="2">
      <p class="ob-question">Where's your code hosted?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="host" data-value="github">GitHub</button>
        <button class="ob-btn" data-key="host" data-value="gitlab">GitLab</button>
        <button class="ob-btn" data-key="host" data-value="other">Other / not yet</button>
      </div>
    </div>

    <div class="ob-step hidden" data-step="3">
      <p class="ob-question">Which terminal do you use?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="terminal" data-value="warp">Warp</button>
        <button class="ob-btn" data-key="terminal" data-value="other">Other (iTerm2, VS Code, Terminal.app, etc.)</button>
      </div>
    </div>
  </div>

  <!-- ── Guide (replaces wizard, one step at a time) ─────── -->
  <div id="ob-guide-panel" class="hidden">
    <div class="ob-guide-nav">
      <span class="ob-guide-progress" id="ob-guide-progress"></span>
      <button class="ob-reset" id="ob-reset">Start over</button>
    </div>
    <div class="ob-guide-step" id="ob-guide-step"></div>
    <div class="ob-guide-footer">
      <button class="ob-prev hidden" id="ob-prev">&larr; Back</button>
      <button class="ob-next" id="ob-next">Next &rarr;</button>
    </div>
  </div>
</div>

<style>
  .ob-wizard {
    background: rgba(167, 139, 250, 0.15);
    border: 1.5px solid rgba(167, 139, 250, 0.4);
    border-radius: var(--radius);
    padding: 2rem 2rem;
    margin-top: 1.5rem;
    margin-left: -2rem;
    margin-right: -2rem;
  }

  :root[data-theme="light"] .ob-wizard {
    background: rgba(147, 51, 234, 0.1);
    border-color: rgba(147, 51, 234, 0.25);
  }

  .hidden { display: none !important; }

  /* ── Wizard header ─────────────────────────────────────── */
  .ob-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .ob-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    margin: 0 0 0.35rem;
  }

  .ob-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Progress dots ─────────────────────────────────────── */
  .ob-progress {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .ob-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background 0.2s;
  }

  .ob-dot.active { background: var(--color-accent); }
  .ob-dot.done { background: var(--color-green); }

  /* ── Question steps ────────────────────────────────────── */
  .ob-question {
    font-weight: 600;
    color: var(--color-text);
    margin-top: 1.25rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
    text-align: center;
  }

  .ob-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .ob-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.3rem;
    border: 1.5px solid var(--color-accent-dim);
    border-radius: var(--radius-xs);
    background: rgba(167, 139, 250, 0.08);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-sans);
  }

  .ob-btn:hover {
    border-color: var(--color-accent);
    background: rgba(167, 139, 250, 0.15);
    color: var(--color-text);
  }

  .ob-btn.selected {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .ob-btn-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* ── Guide panel ───────────────────────────────────────── */
  .ob-guide-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .ob-guide-progress {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .ob-reset {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1.5px solid var(--color-accent-dim);
    border-radius: var(--radius-xs);
    background: rgba(167, 139, 250, 0.08);
    color: var(--color-text-secondary);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s;
  }

  .ob-reset:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    background: rgba(167, 139, 250, 0.15);
  }

  /* ── Dynamic content (injected via JS innerHTML) ──────── */
  /* These use :global() because Astro scoping attributes
     are NOT added to dynamically-generated elements. */

  .ob-wizard :global(.ob-guide-step-title) {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .ob-wizard :global(.ob-guide-step-summary) {
    font-size: 0.92rem;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  .ob-wizard :global(.ob-guide-step-summary a) {
    color: var(--color-accent);
    text-decoration: none;
  }

  .ob-wizard :global(.ob-guide-step-summary a:hover) {
    text-decoration: underline;
  }

  .ob-guide-step {
    text-align: left;
  }

  .ob-wizard :global(.ob-cmd-label) {
    font-size: 0.88rem;
    color: var(--color-text);
    margin: 1.25rem 0 0.25rem;
    font-weight: 500;
  }

  .ob-wizard :global(.ob-cmd-label:first-child) {
    margin-top: 0.25rem;
  }

  /* ── Code blocks with inline copy icon ─────────────────── */
  .ob-wizard :global(.ob-code-wrap) {
    position: relative;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .ob-wizard :global(.ob-code) {
    display: block;
    font-family: var(--font-mono, 'SF Mono', 'Fira Code', monospace);
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.6rem 2.8rem 0.6rem 0.85rem;
    border-radius: var(--radius-xs);
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0;
  }

  :root[data-theme="light"] .ob-wizard :global(.ob-code) {
    background: rgba(0, 0, 0, 0.04);
  }

  .ob-wizard :global(.ob-copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .ob-wizard :global(.ob-copy-btn:hover) {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.1);
  }

  .ob-wizard :global(.ob-copy-btn.copied) {
    color: var(--color-green);
  }

  .ob-wizard :global(.ob-copy-btn svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* ── Inline notes ─────────────────────────────────────── */
  .ob-wizard :global(.ob-note) {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0.75rem 0 0.35rem;
  }

  .ob-wizard :global(.ob-note code) {
    font-size: 0.82em;
  }

  /* ── Collapsible details ──────────────────────────────── */
  .ob-wizard :global(.ob-details) {
    margin-top: 0.75rem;
  }

  .ob-wizard :global(.ob-details summary) {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .ob-wizard :global(.ob-details summary::-webkit-details-marker) {
    display: none;
  }

  .ob-wizard :global(.ob-details summary::before) {
    content: '\25B8  ';
    color: var(--color-text-muted);
  }

  .ob-wizard :global(.ob-details[open] summary::before) {
    content: '\25BE  ';
  }

  .ob-wizard :global(.ob-details[open] summary) {
    margin-bottom: 0.25rem;
  }

  /* ── Checklist ─────────────────────────────────────────── */
  .ob-wizard :global(.ob-checklist) {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
  }

  .ob-wizard :global(.ob-checklist li) {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    padding: 0.15rem 0 0.15rem 1.25rem;
    position: relative;
  }

  .ob-wizard :global(.ob-checklist li::before) {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 700;
  }

  /* ── Guide footer ──────────────────────────────────────── */
  .ob-guide-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .ob-prev, .ob-next {
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--color-accent-dim);
    border-radius: var(--radius-xs);
    background: rgba(167, 139, 250, 0.08);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s;
  }

  .ob-prev:hover, .ob-next:hover {
    border-color: var(--color-accent);
    background: rgba(167, 139, 250, 0.15);
    color: var(--color-text);
  }

  .ob-next {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .ob-next:hover {
    opacity: 0.9;
    color: #fff;
  }

</style>

<script is:inline>
  (function() {
    var answers = {};
    var wizard = document.getElementById('ob-wizard');
    var questionsPanel = document.getElementById('ob-questions');
    var guidePanel = document.getElementById('ob-guide-panel');
    var steps = wizard.querySelectorAll('.ob-step');
    var dots = wizard.querySelectorAll('.ob-dot');
    var guideStep = document.getElementById('ob-guide-step');
    var resetBtn = document.getElementById('ob-reset');
    var progressLabel = document.getElementById('ob-guide-progress');
    var prevBtn = document.getElementById('ob-prev');
    var nextBtn = document.getElementById('ob-next');
    var guideSteps = [];
    var currentGuideStep = 0;

    var copySvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    var checkSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    wizard.addEventListener('click', function(e) {
      var copyBtn = e.target.closest('.ob-copy-btn');
      if (copyBtn) {
        var code = copyBtn.getAttribute('data-copy');
        navigator.clipboard.writeText(code).then(function() {
          copyBtn.innerHTML = checkSvg;
          copyBtn.classList.add('copied');
          setTimeout(function() {
            copyBtn.innerHTML = copySvg;
            copyBtn.classList.remove('copied');
          }, 2000);
        });
        return;
      }

      var btn = e.target.closest('.ob-btn');
      if (!btn) return;

      var step = btn.closest('.ob-step');
      var stepNum = parseInt(step.getAttribute('data-step'));
      var key = btn.getAttribute('data-key');

      step.querySelectorAll('.ob-btn').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      answers[key] = btn.getAttribute('data-value');

      dots[stepNum - 1].classList.remove('active');
      dots[stepNum - 1].classList.add('done');

      if (stepNum < 3) {
        var next = wizard.querySelector('[data-step="' + (stepNum + 1) + '"]');
        if (next) {
          next.classList.remove('hidden');
          dots[stepNum].classList.add('active');
        }
      } else {
        buildGuide();
      }
    });

    prevBtn.addEventListener('click', function() {
      if (currentGuideStep > 0) {
        currentGuideStep--;
        renderGuideStep();
      }
    });

    nextBtn.addEventListener('click', function() {
      if (currentGuideStep < guideSteps.length - 1) {
        currentGuideStep++;
        renderGuideStep();
      }
    });

    function doRestart() {
      answers = {};
      currentGuideStep = 0;
      guideSteps = [];
      steps.forEach(function(s, i) {
        if (i === 0) s.classList.remove('hidden');
        else s.classList.add('hidden');
        s.querySelectorAll('.ob-btn').forEach(function(b) { b.classList.remove('selected'); });
      });
      dots.forEach(function(d, i) {
        d.classList.remove('done', 'active');
        if (i === 0) d.classList.add('active');
      });
      guidePanel.classList.add('hidden');
      questionsPanel.classList.remove('hidden');
    }

    resetBtn.addEventListener('click', doRestart);

    function cmd(code, label) {
      var escaped = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var html = '';
      if (label) html += '<p class="ob-cmd-label">' + label + '</p>';
      html += '<div class="ob-code-wrap">' +
        '<pre class="ob-code">' + escaped + '</pre>' +
        '<button class="ob-copy-btn" data-copy="' + code.replace(/"/g, '&quot;') + '" title="Copy to clipboard">' + copySvg + '</button>' +
      '</div>';
      return html;
    }

    function checklist(items) {
      return '<ul class="ob-checklist">' + items.map(function(i) { return '<li>' + i + '</li>'; }).join('') + '</ul>';
    }

    function renderGuideStep() {
      var s = guideSteps[currentGuideStep];
      var html = '<h3 class="ob-guide-step-title">' + s.title + '</h3>';
      html += '<p class="ob-guide-step-summary">' + s.summary + '</p>';
      s.commands.forEach(function(c) {
        html += cmd(c.code, c.label);
      });
      if (s.more) html += s.more;
      guideStep.innerHTML = html;

      progressLabel.textContent = 'Step ' + (currentGuideStep + 1) + ' of ' + guideSteps.length;

      // Show/hide nav buttons
      if (currentGuideStep === 0) {
        prevBtn.classList.add('hidden');
      } else {
        prevBtn.classList.remove('hidden');
      }

      if (currentGuideStep === guideSteps.length - 1) {
        nextBtn.classList.add('hidden');
      } else {
        nextBtn.classList.remove('hidden');
      }
    }

    function buildGuide() {
      var isNew = answers.project === 'new';
      var isGH = answers.host === 'github';
      var isGL = answers.host === 'gitlab';
      var isWarp = answers.terminal === 'warp';

      // --- Host-specific auth note ---
      var hostAuthNote = '';
      if (isGH) {
        hostAuthNote = cmd('gh auth login', 'Log in to GitHub so VibeCrew can create pull requests for you:') +
          '<p class="ob-note">Choose "HTTPS" and "Login with a web browser" when prompted.</p>';
      } else if (isGL) {
        hostAuthNote = cmd('glab auth login', 'Log in to GitLab so VibeCrew can create merge requests for you:');
      }

      // --- Step 1: Install VibeCrew ---
      var step1 = {
        title: 'Install VibeCrew',
        summary: 'One command installs everything: Homebrew (macOS), Git, Node.js, jq, and VibeCrew itself.',
        commands: [
          { code: 'curl -fsSL https://raw.githubusercontent.com/fabkrum/vibe-crew/main/bootstrap.sh | bash', label: 'Paste this into your terminal to install everything automatically:' }
        ],
        more: '<p class="ob-note">This installs Homebrew (+ Xcode tools &amp; Git), Node.js, jq, and downloads VibeCrew. Safe to re-run &mdash; existing installs are skipped.</p>' +
        '<details class="ob-details"><summary>Prefer to install manually?</summary>' +
        cmd('git clone https://github.com/fabkrum/vibe-crew.git ~/claude-plugins/vibe-crew', 'Download the VibeCrew source code:') +
        cmd('cd ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew && ./install.sh', 'Run the dependency installer:') +
        hostAuthNote +
        '</details>',
        show: true
      };

      // --- Step 2: Open your project ---
      var step2Commands, step2Summary;
      if (isNew) {
        step2Summary = 'Create your project folder and launch Claude Code with VibeCrew.';
        step2Commands = [
          { code: 'mkdir ~/my-project && cd ~/my-project', label: 'Create a folder for your project and navigate into it:' },
          { code: 'claude --plugin-dir ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew', label: 'Start Claude Code with VibeCrew enabled:' }
        ];
      } else {
        step2Summary = 'Navigate to your existing project and launch Claude Code with VibeCrew.';
        step2Commands = [
          { code: 'cd ~/my-project', label: 'Go to your project folder:' },
          { code: 'claude --plugin-dir ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew', label: 'Start Claude Code with VibeCrew enabled:' }
        ];
      }
      var step2 = {
        title: 'Open your project',
        summary: step2Summary,
        commands: step2Commands,
        more: '<p class="ob-guide-step-summary" style="margin-top:0.5rem;font-size:0.82rem;color:var(--color-text-muted)">Replace <code>~/my-project</code> with your actual project path.' +
          (isWarp ? ' Warp auto-detects VibeCrew and shows the plugin badge.' : '') +
          '</p>',
        show: true
      };

      // --- Step 3: Set up your environment ---
      var step3 = {
        title: 'Set up your environment',
        summary: 'Inside Claude Code, run two commands to verify your install and personalize your experience.',
        commands: [
          { code: '/setup', label: 'Check your installation and configure VibeCrew:' },
          { code: '/profile', label: 'Choose how VibeCrew communicates with you:' }
        ],
        more: '<p class="ob-note"><code>/setup</code> verifies dependencies, detects your terminal, creates the <code>.vibecrew/</code> state directory, and tests notifications. It offers to fix anything missing.</p>' +
        '<p class="ob-note"><code>/profile</code> adapts VibeCrew to how you work through 8 quick questions (~2 minutes): your role, code literacy, autonomy level, PR review style, verbosity, gamification, learning preference, and risk tolerance. You can skip and use balanced defaults.</p>',
        show: true
      };

      // --- Conditional Warp step ---
      var warpStep = {
        title: 'Get the most out of Warp',
        summary: 'VibeCrew auto-detects Warp. Install the notification plugin so clicking a notification jumps to the right tab:',
        commands: [
          { code: 'brew install terminal-notifier', label: 'Enable click-to-jump desktop notifications:' }
        ],
        more: '<p class="ob-note"><code>/setup</code> auto-generates a Launch Configuration for a multi-tab layout (planning + development + terminal). Open it with <kbd>Ctrl+Shift+R</kbd>.</p>' +
          '<p class="ob-note"><strong>Essential shortcuts:</strong> <kbd>Cmd+D</kbd> split pane, <kbd>Cmd+T</kbd> new tab, <kbd>Cmd+K</kbd> command palette, <kbd>Ctrl+`</kbd> toggle blocks.</p>' +
          '<p class="ob-note"><strong>Blocks:</strong> Every command output is a discrete, scrollable, copyable block &mdash; perfect for reviewing long agent output without losing your place.</p>' +
          '<p class="ob-note"><strong>Session restore:</strong> Warp automatically restores your tab layout after a restart. Name your tabs (<kbd>Cmd+Shift+I</kbd>) to keep track of parallel workflows.</p>' +
          '<p class="ob-note"><strong>Warp Drive:</strong> Save and share VibeCrew workflows with your team. Any slash command sequence can become a reusable Warp Drive workflow.</p>' +
          '<p class="ob-note"><strong>Voice input:</strong> Pair with <a href="https://wispr.com" target="_blank">Wispr Flow</a> to dictate prompts hands-free &mdash; say what you want and VibeCrew builds it.</p>',
        show: isWarp
      };

      // --- Step 4: Start building ---
      var step4Commands, step4Summary, step4More;
      if (isNew) {
        step4Summary = 'VibeCrew guides you through architecture decisions, then you build your first feature.';
        step4Commands = [
          { code: '/new-project', label: 'Create your project foundation (vision, design, tech stack):' },
          { code: '/new-feature "user authentication"', label: 'Build your first feature:' }
        ];
        step4More = '<p class="ob-note"><code>/new-project</code> creates your project foundation: VISION.md, design system, tech stack (TDR), architecture diagrams, roadmap, and CLAUDE.md. This is a one-time step &mdash; every feature session after starts instantly.</p>';
      } else {
        step4Summary = 'Let VibeCrew analyze your codebase (read-only), then start building features.';
        step4Commands = [
          { code: '/onboard', label: 'Let VibeCrew analyze your existing codebase (read-only):' },
          { code: '/new-feature "your feature name"', label: 'Build your first feature:' }
        ];
        step4More = '<p class="ob-note"><code>/onboard</code> analyzes your stack, conventions, test gaps, and design system (read-only). It generates a CLAUDE.md with project rules. Nothing is modified.</p>';
      }
      var step4 = {
        title: 'Start building',
        summary: step4Summary,
        commands: step4Commands,
        more: step4More +
          '<p class="ob-note">Each feature goes through: Plan &rarr; UI Design &rarr; Code &rarr; Test &rarr; Review &rarr; Docs. Use <code>/wrap</code> to run the quality gate and commit your work.</p>',
        show: true
      };

      var allSteps = [step1, step2, step3, warpStep, step4];
      guideSteps = allSteps.filter(function(s) { return s.show; });
      currentGuideStep = 0;

      renderGuideStep();
      questionsPanel.classList.add('hidden');
      guidePanel.classList.remove('hidden');
    }
  })();
</script>
