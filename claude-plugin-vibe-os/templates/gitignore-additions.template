# =============================================================================
# VibeOS .gitignore Additions
# =============================================================================
# Recommended additions for projects managed by VibeOS.
# Copy the relevant lines into your project's .gitignore file.
# =============================================================================

# -----------------------------------------------------------------------------
# VibeOS runtime state (do NOT commit)
# These files are local to your machine and session. They contain terminal
# preferences, ephemeral inter-agent signals, advisory locks, and transient
# logs that have no value in version control.
# -----------------------------------------------------------------------------
.vibeos/config.json
.vibeos/signals/
.vibeos/locks/
.vibeos/notifications.log
.vibeos/session-cost.json

# -----------------------------------------------------------------------------
# VibeOS state that SHOULD be committed
# These files track project-level state that is valuable to the team.
# They are listed here commented out so you do not accidentally ignore them.
# Do NOT uncomment these lines.
# -----------------------------------------------------------------------------
# .vibeos/state.json        — project foundation status and active feature
# .vibeos/backlog.json      — feature backlog with specs and priorities
# .vibeos/sessions/         — session history logs (audit trail)
# .vibeos/scores/           — vibe score breakdowns (quality tracking)
# .vibeos/releases/         — release notes data

# -----------------------------------------------------------------------------
# Common development artifacts
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
.next/
.nuxt/
.output/
coverage/
*.log
.env
.env.local
.env.*.local

# -----------------------------------------------------------------------------
# IDE and editor files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
