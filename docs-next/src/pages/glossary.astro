---
import DocsLayout from '../layouts/DocsLayout.astro';
import { glossary } from '../data/glossary';

// Group terms alphabetically
const grouped = glossary.reduce((acc, term) => {
  const letter = term.term[0].toUpperCase();
  if (!acc[letter]) acc[letter] = [];
  acc[letter].push(term);
  return acc;
}, {} as Record<string, typeof glossary>);

const letters = Object.keys(grouped).sort();
---

<DocsLayout title="Glossary" sectionLabel="Reference" activeSlug="glossary">

  <h2>Glossary</h2>
  <p>Key terms and concepts used throughout VibeCrew. Click a letter to jump to that section.</p>

  <div class="letter-nav">
    {letters.map((letter) => (
      <a href={`#letter-${letter}`}>{letter}</a>
    ))}
  </div>

  {letters.map((letter) => (
    <section class="glossary-section" id={`letter-${letter}`}>
      <h3 class="letter-heading">{letter}</h3>
      <dl class="glossary-list">
        {grouped[letter].map((entry) => (
          <div class="glossary-entry" id={entry.term.toLowerCase().replace(/[\s\/]/g, '-')}>
            <dt>{entry.term}</dt>
            <dd set:html={entry.definition} />
          </div>
        ))}
      </dl>
    </section>
  ))}
</DocsLayout>

<style>
  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .letter-nav a {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-xs);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
  }

  .letter-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .letter-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    margin-top: 2rem;
  }

  .glossary-list {
    margin: 0 0 2rem;
  }

  .glossary-entry {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .glossary-entry:last-child {
    border-bottom: none;
  }

  dt {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
