---
import { businessLandingSvgs } from './business-landing-svgs';
import { businessOnboardingSvgs } from './business-onboarding-svgs';
import { businessFormsSvgs } from './business-forms-svgs';
import { businessTrustSvgs } from './business-trust-svgs';
import { businessPricingSvgs } from './business-pricing-svgs';
import { businessEmptyStatesSvgs } from './business-empty-states-svgs';
import { businessRetentionSvgs } from './business-retention-svgs';
import { businessNavigationSvgs } from './business-navigation-svgs';
import { businessFeedbackSvgs } from './business-feedback-svgs';

interface Props {
  name: string;
}

const { name } = Astro.props;

const allSvgs: Record<string, string> = {
  ...businessLandingSvgs,
  ...businessOnboardingSvgs,
  ...businessFormsSvgs,
  ...businessTrustSvgs,
  ...businessPricingSvgs,
  ...businessEmptyStatesSvgs,
  ...businessRetentionSvgs,
  ...businessNavigationSvgs,
  ...businessFeedbackSvgs,
};

const svg = allSvgs[name];
---

{svg && (
  <div class="pattern-illustration" set:html={svg} />
)}

<style>
  .pattern-illustration {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
  }

  .pattern-illustration :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
