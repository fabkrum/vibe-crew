---

<DocsLayout title="Daily Workflow" sectionLabel="Workflows" activeSlug="workflow">

  <div class="toc">
    <h3>On This Page</h3>
    <ol>
      <li><a href="#daily-rhythm">A Normal Workday</a></li>
