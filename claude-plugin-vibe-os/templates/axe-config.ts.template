// Generated by VibeOS — axe-core accessibility config

import type { Page } from '@playwright/test';
import AxeBuilder from '@axe-core/playwright';

/**
 * Default axe-core configuration targeting WCAG 2.1 AA compliance.
 */
export const axeConfig = {
  rules: [
    { id: 'color-contrast', enabled: true },
    { id: 'label', enabled: true },
    { id: 'image-alt', enabled: true },
    { id: 'link-name', enabled: true },
    { id: 'button-name', enabled: true },
    { id: 'heading-order', enabled: true },
    { id: 'landmark-one-main', enabled: true },
    { id: 'region', enabled: true },
  ],
  tags: ['wcag2a', 'wcag2aa', 'wcag21aa', 'best-practice'],
};

export default axeConfig;

/**
 * Run an accessibility check on a Playwright page.
 *
 * @param page - The Playwright Page instance to audit.
 * @param selector - Optional CSS selector to scope the analysis. Defaults to the full page.
 * @returns An array of axe-core violation objects. An empty array means no violations.
 *
 * @example
 * ```ts
 * const violations = await checkA11y(page, 'main');
 * expect(violations).toHaveLength(0);
 * ```
 */
export async function checkA11y(
  page: Page,
  selector?: string,
): Promise<import('axe-core').Result[]> {
  let builder = new AxeBuilder({ page })
    .withTags(axeConfig.tags)
    .options({ rules: axeConfig.rules });

  if (selector) {
    builder = builder.include(selector);
  }

  const results = await builder.analyze();
  return results.violations;
}
