---
import DocsLayout from '../layouts/DocsLayout.astro';
import Callout from '../components/Callout.astro';
import OnboardingWizard from '../components/why/OnboardingWizard.astro';
import { url } from '../data/site';
---

<DocsLayout title="VibeCrew">

  <!-- ── Hero: title + subtitle + wizard ───────────────────── -->
  <section class="hero-section" id="start">
    <h1 class="hero-title">VibeCrew</h1>
    <p class="hero-subtitle">The autonomous vibe-coding operating system for Claude Code</p>
    <p class="hero-desc">Orchestrates 14 AI agents across the full development lifecycle &mdash; architecture, design, code, tests, review, and docs. You describe what you want. VibeCrew builds it right.</p>
    <OnboardingWizard />
  </section>

  <!-- ── What VibeCrew handles ───────────────────────────────── -->
  <section class="section" id="hard-parts">
    <h3>The hard parts, handled</h3>
    <div class="why-cards">
      <div class="card why-card">
        <h4><span class="card-icon green">&#9670;</span> Architecture before code</h4>
        <p>Vision, design system, tech stack, and architecture are locked in before any code is written. A phase gate enforces this &mdash; no shortcuts.</p>
      </div>

      <div class="card why-card">
        <h4><span class="card-icon blue">&#9670;</span> Quality on autopilot</h4>
        <p>Tests, linting, type checking, build verification, code review, and security auditing run automatically on every feature.</p>
      </div>

      <div class="card why-card">
        <h4><span class="card-icon purple">&#9670;</span> Patterns that convert</h4>
        <p>Built-in UI and business pattern libraries guide agents toward production-quality output &mdash; proper error states, accessible interactions, conversion-optimized layouts.</p>
      </div>

      <div class="card why-card">
        <h4><span class="card-icon amber">&#9670;</span> Tokens spent wisely</h4>
        <p>Worktree isolation, MCP servers, zero-token hooks, and forced compaction between features keep costs down. Free and open source.</p>
      </div>
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────────── -->
  <section class="section" id="how-it-works">
    <h3>How it works</h3>

    <details class="how-details">
      <summary>Parallel multi-project workflows</summary>
      <div class="how-answer">
        <p>Plan Project A while VibeCrew codes Project B and tests Project C. Notifications fire only when an agent needs a decision, finishes a task, or hits an error &mdash; one click takes you to the right tab.</p>
      </div>
    </details>

    <details class="how-details">
      <summary>Smart context management</summary>
      <div class="how-answer">
        <p>Worktree isolation keeps research tokens separate. Forced compaction between features prevents context rot. MCP servers replace pasting docs. You never hit the context wall.</p>
      </div>
    </details>

    <details class="how-details">
      <summary>Self-improving Performance Coach</summary>
      <div class="how-answer">
        <p>Every session gets a Vibe Score. The coach identifies waste, proposes a permanent rule to prevent it, and writes it with your approval. Each session more efficient than the last.</p>
      </div>
    </details>

    <details class="how-details">
      <summary>Adapts to you</summary>
      <div class="how-answer">
        <p>Run <code>/profile</code> &mdash; a 2-minute interview or pick a preset. Personalizes verbosity, autonomy, PR format, code comments, and risk tolerance.</p>
      </div>
    </details>
  </section>

  <!-- ── Community ───────────────────────────────────────────── -->
  <section class="section" id="community">
    <h3>Built with the community</h3>
    <div class="community-grid">
      <div class="card community-card">
        <h4>Propose a feature</h4>
        <p>Have an idea? <a href="https://github.com/fabkrum/vibe-crew/issues/new?labels=enhancement&template=feature_request.md" class="community-link">Open a feature request &rarr;</a></p>
      </div>

      <div class="card community-card">
        <h4>Report a problem</h4>
        <p>Found a bug? <a href="https://github.com/fabkrum/vibe-crew/issues/new?labels=bug&template=bug_report.md" class="community-link">File an issue &rarr;</a></p>
      </div>

      <div class="card community-card">
        <h4>Share what you built</h4>
        <p>Show it off! <a href="https://github.com/fabkrum/vibe-crew/discussions/categories/show-and-tell" class="community-link">Post in Discussions &rarr;</a></p>
      </div>
    </div>
  </section>

</DocsLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero-section {
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-size: 2rem;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }

  .hero-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* ── Card grid for "hard parts" ──────────────────────────── */
  .why-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .why-cards {
      grid-template-columns: 1fr;
    }
  }

  .why-card {
    padding: 1rem 1.25rem;
  }

  .why-card h4 {
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }

  .why-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .card-icon {
    font-size: 0.65rem;
    margin-right: 0.2rem;
  }
  .card-icon.green { color: var(--color-green); }
  .card-icon.blue { color: var(--color-blue); }
  .card-icon.purple { color: var(--color-accent); }
  .card-icon.amber { color: var(--color-amber); }

  /* ── Accordion (how it works) ────────────────────────────── */
  .how-details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: 0.5rem;
    overflow: hidden;
  }

  .how-details summary {
    padding: 0.85rem 1.25rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.15s;
    list-style: none;
  }

  .how-details summary::-webkit-details-marker {
    display: none;
  }

  .how-details summary::after {
    content: '+';
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .how-details[open] summary::after {
    content: '\2212';
  }

  .how-details summary:hover {
    background: var(--color-surface);
  }

  .how-answer {
    padding: 0 1.25rem 0.85rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .how-answer p {
    margin: 0;
    padding-top: 0.5rem;
    font-size: 0.9rem;
  }

  /* ── Community grid ──────────────────────────────────────── */
  .community-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .community-grid {
      grid-template-columns: 1fr;
    }
  }

  .community-card {
    padding: 1rem 1.25rem;
  }

  .community-card h4 {
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }

  .community-card p {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .community-link {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .community-link:hover {
    text-decoration: underline;
  }
</style>
