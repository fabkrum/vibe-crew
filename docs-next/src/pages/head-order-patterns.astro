---
import DocsLayout from '../layouts/DocsLayout.astro';
import HeadOrderPatternIllustration from '../components/patterns/HeadOrderPatternIllustration.astro';
import { headOrderPatterns, categoryLabels, categoryOrder } from '../data/head-order-patterns';
import type { HeadOrderPattern } from '../data/head-order-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = headOrderPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof headOrderPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<HeadOrderPattern['category'], string> = {
  pragma: 'Pragma directives that MUST appear first in the <head>. These tell the browser how to parse and handle the document. Late discovery forces costly re-parsing or disables security protections. capo.js weight: 10 (highest).',
  critical: 'Render-blocking and high-priority resources that directly affect when the browser can start painting. The order within this group determines whether resources download in parallel or serially. capo.js weights: 9 (title) through 4 (sync styles).',
  hints: 'Resource hints and optimization directives for resources needed on the current page or future navigations. Lower priority than render-blocking resources -- they should never displace critical elements. capo.js weights: 3 (preload) through 1 (prefetch).',
  anti_patterns: 'Common head ordering mistakes that cause measurable performance regressions. Each anti-pattern includes the incorrect ordering, the correct alternative, and the measured performance cost. Flagged by ct.css and/or capo.js.',
  seo_social: 'SEO metadata, social sharing tags, and non-rendering resources. These have zero impact on page rendering and belong at the very bottom of <head>. capo.js weight: 0 (lowest). Never let these displace render-critical elements.',
  tooling: 'Tools for auditing and automatically enforcing optimal <head> element ordering. Use these to validate your head ordering and catch regressions. Framework integrations can make correct ordering the default.',
};
---

<DocsLayout title="Head Order Patterns" sectionLabel="Reference" activeSlug="head-order-patterns">

  <h2>HTML &lt;head&gt; Order Patterns</h2>
  <p>Research-backed patterns for optimal HTML <code>&lt;head&gt;</code> element ordering, based on Harry Roberts' (CSS Wizardry) performance research, Rick Viscomi's <a href="https://github.com/rviscomi/capo.js" target="_blank" rel="noopener noreferrer">capo.js</a> 11-weight system, and browser preload scanner behavior. Misordered <code>&lt;head&gt;</code> elements can delay rendering by up to 7 seconds. The <code>&lt;head&gt;</code> is the single biggest render-blocking part of your page -- getting it right is one of the highest-impact performance optimizations available.</p>

  <div class="weight-overview">
    <h3 class="weight-title">The Canonical Order (capo.js weights)</h3>
    <ol class="weight-list">
      <li><span class="weight-num">10</span> <strong>Pragma Directives</strong> -- charset, viewport, CSP, base, http-equiv</li>
      <li><span class="weight-num">9</span> <strong>Title</strong> -- &lt;title&gt; element</li>
      <li><span class="weight-num">8</span> <strong>Preconnect</strong> -- &lt;link rel="preconnect"&gt;</li>
      <li><span class="weight-num">7</span> <strong>Async Scripts</strong> -- &lt;script async src&gt;</li>
      <li><span class="weight-num">6</span> <strong>@import Styles</strong> -- &lt;style&gt; with @import (discouraged)</li>
      <li><span class="weight-num">5</span> <strong>Sync Scripts</strong> -- &lt;script src&gt; (no async/defer)</li>
      <li><span class="weight-num">4</span> <strong>Sync Styles</strong> -- &lt;link rel="stylesheet"&gt;, &lt;style&gt;</li>
      <li><span class="weight-num">3</span> <strong>Preload</strong> -- &lt;link rel="preload"&gt;, modulepreload</li>
      <li><span class="weight-num">2</span> <strong>Deferred Scripts</strong> -- &lt;script defer&gt;, &lt;script type="module"&gt;</li>
      <li><span class="weight-num">1</span> <strong>Prefetch / Prerender</strong> -- dns-prefetch, prefetch, prerender</li>
      <li><span class="weight-num">0</span> <strong>Everything Else</strong> -- OG tags, description, icons, canonical</li>
    </ol>
  </div>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+@"=]/g, '-')}>
            <div class="pattern-card-inner">
              <HeadOrderPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Performance Impact</span>
                    <p>{entry.impact}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Quick Reference: Optimal &lt;head&gt; Template</h3>
    <pre class="code-block"><code>&lt;head&gt;
  &lt;!-- 1. Pragma directives (weight 10) --&gt;
  &lt;meta charset="utf-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1"&gt;
  &lt;meta http-equiv="content-security-policy" content="..."&gt;

  &lt;!-- 2. Title (weight 9) --&gt;
  &lt;title&gt;Page Title&lt;/title&gt;

  &lt;!-- 3. Preconnect (weight 8) --&gt;
  &lt;link rel="preconnect" href="https://fonts.googleapis.com"&gt;
  &lt;link rel="preconnect" href="https://fonts.gstatic.com" crossorigin&gt;

  &lt;!-- 4. Async scripts (weight 7) --&gt;
  &lt;script async src="https://www.googletagmanager.com/gtag/js?id=G-..."&gt;&lt;/script&gt;

  &lt;!-- 5. Sync scripts before CSS (weight 5) --&gt;
  &lt;script src="/critical-non-cssom.js"&gt;&lt;/script&gt;

  &lt;!-- 6. Sync styles (weight 4) --&gt;
  &lt;style&gt;/* critical inline CSS */&lt;/style&gt;
  &lt;link rel="stylesheet" href="/main.css"&gt;

  &lt;!-- 7. Preload (weight 3) --&gt;
  &lt;link rel="preload" href="/font.woff2" as="font" type="font/woff2" crossorigin&gt;
  &lt;link rel="preload" href="/hero.webp" as="image" fetchpriority="high"&gt;

  &lt;!-- 8. Deferred scripts (weight 2) --&gt;
  &lt;script defer src="/app.js"&gt;&lt;/script&gt;

  &lt;!-- 9. Prefetch / prerender (weight 1) --&gt;
  &lt;link rel="dns-prefetch" href="https://analytics.example.com"&gt;
  &lt;link rel="prefetch" href="/next-page"&gt;

  &lt;!-- 10. Everything else (weight 0) --&gt;
  &lt;meta name="description" content="..."&gt;
  &lt;link rel="canonical" href="https://example.com/page"&gt;
  &lt;meta property="og:title" content="Page Title"&gt;
  &lt;meta property="og:image" content="https://example.com/og.jpg"&gt;
  &lt;link rel="icon" href="/favicon.svg" type="image/svg+xml"&gt;
  &lt;link rel="alternate" type="application/rss+xml" href="/feed.xml"&gt;
&lt;/head&gt;</code></pre>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement head ordering. Click through for full details.</p>
    <ul class="related-links">
      <li><a href="/seo-patterns">SEO & AI Discoverability</a> &mdash; Structured data, meta tags, and search optimization patterns that live in the <code>&lt;head&gt;</code></li>
      <li><a href="/social-patterns#structured-identity">Structured Identity</a> &mdash; Open Graph, Schema.org, and rel="me" patterns for the bottom of <code>&lt;head&gt;</code></li>
      <li><a href="/media-patterns#lazy-loading">Lazy Loading</a> &mdash; Image and media optimization patterns that interact with preload hints</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://rviscomi.github.io/capo.js/" target="_blank" rel="noopener noreferrer">capo.js Documentation</a> &mdash; The definitive head ordering tool with 11-weight system and Chrome extension</li>
      <li><a href="https://csswizardry.com/ct/" target="_blank" rel="noopener noreferrer">ct.css by Harry Roberts</a> &mdash; CSS-only diagnostic snippet for head element anti-patterns</li>
      <li><a href="https://csswizardry.com/2018/11/css-and-network-performance/" target="_blank" rel="noopener noreferrer">CSS and Network Performance</a> &mdash; Harry Roberts' foundational article on CSS/JS ordering and the preload scanner</li>
      <li><a href="https://csswizardry.com/2022/10/speeding-up-async-snippets/" target="_blank" rel="noopener noreferrer">Speeding Up Async Snippets</a> &mdash; Why static &lt;script async&gt; beats JavaScript-injected snippets</li>
      <li><a href="https://web.dev/articles/preload-scanner" target="_blank" rel="noopener noreferrer">Don't Fight the Browser Preload Scanner</a> &mdash; web.dev deep dive on how the preload scanner discovers resources</li>
      <li><a href="https://csswizardry.com/2023/12/correctly-configure-preconnections/" target="_blank" rel="noopener noreferrer">Correctly Configure Preconnections</a> &mdash; When to use preconnect vs dns-prefetch and common mistakes</li>
      <li><a href="https://csswizardry.com/2023/01/why-not-document-write/" target="_blank" rel="noopener noreferrer">Why Not document.write()?</a> &mdash; The performance and security case against document.write()</li>
      <li><a href="https://rviscomi.github.io/capo.js/user/rules/" target="_blank" rel="noopener noreferrer">The Rules of capo.js</a> &mdash; Complete documentation of all 11 weight categories with rationale</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .weight-overview { margin: 1.5rem 0 2rem; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .weight-title { font-size: 1.1rem; font-weight: 800; color: var(--color-text); margin: 0 0 0.75rem; }
  .weight-list { margin: 0; padding: 0 0 0 1rem; list-style: none; counter-reset: none; }
  .weight-list li { padding: 0.3rem 0; font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.5; }
  .weight-num { display: inline-block; width: 1.8rem; font-family: monospace; font-weight: 700; font-size: 0.82rem; color: var(--color-accent); text-align: right; margin-right: 0.5rem; }
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); overflow: hidden; }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); overflow-wrap: break-word; }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .code-block { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1.25rem; overflow-x: auto; margin-top: 1rem; font-size: 0.82rem; line-height: 1.7; }
  .code-block code { font-family: 'SF Mono', 'Fira Code', 'Fira Mono', monospace; color: var(--color-text-secondary); }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
