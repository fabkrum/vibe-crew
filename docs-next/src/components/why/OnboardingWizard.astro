---
import { url } from '../../data/site';
---

<div class="ob-wizard" id="ob-wizard">
  <!-- ── Wizard (questions) ──────────────────────────────── -->
  <div id="ob-questions">
    <div class="ob-header">
      <h2 class="ob-title">What do you want to build today?</h2>
      <p class="ob-subtitle">3 questions. Your personal setup guide. Ready in minutes.</p>
    </div>

    <div class="ob-progress" id="ob-progress">
      <span class="ob-dot active" data-dot="1"></span>
      <span class="ob-dot" data-dot="2"></span>
      <span class="ob-dot" data-dot="3"></span>
    </div>

    <div class="ob-step" data-step="1">
      <p class="ob-question">Are you starting fresh or adding to an existing project?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="project" data-value="new">
          <span class="ob-btn-icon">&#10010;</span>
          New project
        </button>
        <button class="ob-btn" data-key="project" data-value="existing">
          <span class="ob-btn-icon">&#8599;</span>
          Existing project
        </button>
      </div>
    </div>

    <div class="ob-step hidden" data-step="2">
      <p class="ob-question">Where's your code hosted?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="host" data-value="github">GitHub</button>
        <button class="ob-btn" data-key="host" data-value="gitlab">GitLab</button>
        <button class="ob-btn" data-key="host" data-value="other">Other / not yet</button>
      </div>
    </div>

    <div class="ob-step hidden" data-step="3">
      <p class="ob-question">Which terminal do you use?</p>
      <div class="ob-options">
        <button class="ob-btn" data-key="terminal" data-value="warp">Warp</button>
        <button class="ob-btn" data-key="terminal" data-value="other">Other (iTerm2, VS Code, Terminal.app, etc.)</button>
      </div>
    </div>
  </div>

  <!-- ── Guide (replaces wizard, one step at a time) ─────── -->
  <div id="ob-guide-panel" class="hidden">
    <div class="ob-guide-nav">
      <span class="ob-guide-progress" id="ob-guide-progress"></span>
      <div class="ob-guide-pills" id="ob-guide-pills"></div>
    </div>
    <div class="ob-guide-step" id="ob-guide-step"></div>
    <div class="ob-guide-footer">
      <button class="ob-prev hidden" id="ob-prev">&larr; Back</button>
      <button class="ob-next" id="ob-next">Next &rarr;</button>
      <button class="ob-restart hidden" id="ob-restart">Start over</button>
      <div class="ob-footer-links">
        <a class="ob-action-link" href={url('/workflow.html')}>Core Workflow &rarr;</a>
        <a class="ob-action-link" href={url('/faq.html')}>FAQ &rarr;</a>
      </div>
    </div>
  </div>
</div>

<style>
  .ob-wizard {
    background: rgba(167, 139, 250, 0.15);
    border: 1.5px solid rgba(167, 139, 250, 0.4);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    margin-top: 1.5rem;
  }

  :root[data-theme="light"] .ob-wizard {
    background: rgba(147, 51, 234, 0.1);
    border-color: rgba(147, 51, 234, 0.25);
  }

  .hidden { display: none !important; }

  /* ── Wizard header ─────────────────────────────────────── */
  .ob-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .ob-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    margin: 0 0 0.35rem;
  }

  .ob-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Progress dots ─────────────────────────────────────── */
  .ob-progress {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .ob-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background 0.2s;
  }

  .ob-dot.active { background: var(--color-accent); }
  .ob-dot.done { background: var(--color-green); }

  /* ── Question steps ────────────────────────────────────── */
  .ob-question {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    font-size: 1rem;
    text-align: center;
  }

  .ob-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .ob-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-sans);
  }

  .ob-btn:hover {
    border-color: var(--color-accent-dim);
    color: var(--color-text);
  }

  .ob-btn.selected {
    background: var(--color-accent-bg);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .ob-btn-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* ── Guide panel ───────────────────────────────────────── */
  .ob-guide-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .ob-guide-progress {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .ob-guide-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .ob-pill {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 999px;
    background: var(--color-accent-bg);
    color: var(--color-accent);
    border: 1px solid rgba(167, 139, 250, 0.2);
  }

  /* ── Guide step content ────────────────────────────────── */
  .ob-guide-step-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .ob-guide-step-summary {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 0 0.5rem;
  }

  .ob-guide-step-summary a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .ob-guide-step-summary a:hover {
    text-decoration: underline;
  }

  /* ── Code blocks with inline copy icon ─────────────────── */
  .ob-code-wrap {
    position: relative;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .ob-code {
    display: block;
    font-family: var(--font-mono, 'SF Mono', 'Fira Code', monospace);
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.6rem 2.5rem 0.6rem 0.85rem;
    border-radius: var(--radius-xs);
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }

  :root[data-theme="light"] .ob-code {
    background: rgba(0, 0, 0, 0.04);
  }

  .ob-copy-btn {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .ob-copy-btn:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.08);
  }

  .ob-copy-btn.copied {
    color: var(--color-green);
  }

  .ob-copy-btn svg {
    width: 15px;
    height: 15px;
  }

  /* ── Expandable details ────────────────────────────────── */
  .ob-details {
    margin-top: 0.75rem;
    border: none;
  }

  .ob-details summary {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .ob-details summary::-webkit-details-marker { display: none; }

  .ob-details summary::before {
    content: '▸';
    font-size: 0.7rem;
    transition: transform 0.15s;
  }

  .ob-details[open] summary::before {
    transform: rotate(90deg);
  }

  .ob-details-body {
    padding-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .ob-details-body p {
    margin: 0 0 0.35rem;
  }

  .ob-details-body p:last-child {
    margin-bottom: 0;
  }

  /* ── Checklist ─────────────────────────────────────────── */
  .ob-checklist {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
  }

  .ob-checklist li {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    padding: 0.15rem 0 0.15rem 1.25rem;
    position: relative;
  }

  .ob-checklist li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 700;
  }

  /* ── Guide footer ──────────────────────────────────────── */
  .ob-guide-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .ob-prev, .ob-next {
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s;
  }

  .ob-prev:hover, .ob-next:hover {
    border-color: var(--color-accent-dim);
    color: var(--color-text);
  }

  .ob-next {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    font-weight: 600;
  }

  .ob-next:hover {
    opacity: 0.9;
    color: #fff;
  }

  .ob-restart {
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s;
  }

  .ob-restart:hover {
    border-color: var(--color-accent-dim);
    color: var(--color-text);
  }

  .ob-footer-links {
    margin-left: auto;
    display: flex;
    gap: 1rem;
  }

  .ob-action-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .ob-action-link:hover {
    text-decoration: underline;
  }
</style>

<script is:inline>
  (function() {
    var answers = {};
    var wizard = document.getElementById('ob-wizard');
    var questionsPanel = document.getElementById('ob-questions');
    var guidePanel = document.getElementById('ob-guide-panel');
    var steps = wizard.querySelectorAll('.ob-step');
    var dots = wizard.querySelectorAll('.ob-dot');
    var guideStep = document.getElementById('ob-guide-step');
    var pills = document.getElementById('ob-guide-pills');
    var progressLabel = document.getElementById('ob-guide-progress');
    var prevBtn = document.getElementById('ob-prev');
    var nextBtn = document.getElementById('ob-next');
    var restartBtn = document.getElementById('ob-restart');
    var guideSteps = [];
    var currentGuideStep = 0;

    var copySvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    var checkSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    wizard.addEventListener('click', function(e) {
      var copyBtn = e.target.closest('.ob-copy-btn');
      if (copyBtn) {
        var code = copyBtn.getAttribute('data-copy');
        navigator.clipboard.writeText(code).then(function() {
          copyBtn.innerHTML = checkSvg;
          copyBtn.classList.add('copied');
          setTimeout(function() {
            copyBtn.innerHTML = copySvg;
            copyBtn.classList.remove('copied');
          }, 2000);
        });
        return;
      }

      var btn = e.target.closest('.ob-btn');
      if (!btn) return;

      var step = btn.closest('.ob-step');
      var stepNum = parseInt(step.getAttribute('data-step'));
      var key = btn.getAttribute('data-key');

      step.querySelectorAll('.ob-btn').forEach(function(b) { b.classList.remove('selected'); });
      btn.classList.add('selected');
      answers[key] = btn.getAttribute('data-value');

      dots[stepNum - 1].classList.remove('active');
      dots[stepNum - 1].classList.add('done');

      if (stepNum < 3) {
        var next = wizard.querySelector('[data-step="' + (stepNum + 1) + '"]');
        if (next) {
          next.classList.remove('hidden');
          dots[stepNum].classList.add('active');
        }
      } else {
        buildGuide();
      }
    });

    prevBtn.addEventListener('click', function() {
      if (currentGuideStep > 0) {
        currentGuideStep--;
        renderGuideStep();
      }
    });

    nextBtn.addEventListener('click', function() {
      if (currentGuideStep < guideSteps.length - 1) {
        currentGuideStep++;
        renderGuideStep();
      }
    });

    restartBtn.addEventListener('click', function() {
      answers = {};
      currentGuideStep = 0;
      guideSteps = [];
      steps.forEach(function(s, i) {
        if (i === 0) s.classList.remove('hidden');
        else s.classList.add('hidden');
        s.querySelectorAll('.ob-btn').forEach(function(b) { b.classList.remove('selected'); });
      });
      dots.forEach(function(d, i) {
        d.classList.remove('done', 'active');
        if (i === 0) d.classList.add('active');
      });
      guidePanel.classList.add('hidden');
      questionsPanel.classList.remove('hidden');
    });

    function cmd(code) {
      var escaped = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return '<div class="ob-code-wrap">' +
        '<pre class="ob-code">' + escaped + '</pre>' +
        '<button class="ob-copy-btn" data-copy="' + code.replace(/"/g, '&quot;') + '">' + copySvg + '</button>' +
      '</div>';
    }

    function details(label, content) {
      return '<details class="ob-details"><summary>' + label + '</summary>' +
        '<div class="ob-details-body">' + content + '</div></details>';
    }

    function checklist(items) {
      return '<ul class="ob-checklist">' + items.map(function(i) { return '<li>' + i + '</li>'; }).join('') + '</ul>';
    }

    function renderGuideStep() {
      var s = guideSteps[currentGuideStep];
      var html = '<h3 class="ob-guide-step-title">' + s.title + '</h3>';
      html += '<p class="ob-guide-step-summary">' + s.summary + '</p>';
      s.commands.forEach(function(c) {
        html += cmd(c.code);
      });
      if (s.more) html += s.more;
      guideStep.innerHTML = html;

      progressLabel.textContent = 'Step ' + (currentGuideStep + 1) + ' of ' + guideSteps.length;

      // Show/hide nav buttons
      if (currentGuideStep === 0) {
        prevBtn.classList.add('hidden');
      } else {
        prevBtn.classList.remove('hidden');
      }

      if (currentGuideStep === guideSteps.length - 1) {
        nextBtn.classList.add('hidden');
        restartBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        restartBtn.classList.add('hidden');
      }
    }

    function buildGuide() {
      var isNew = answers.project === 'new';
      var isGH = answers.host === 'github';
      var isGL = answers.host === 'gitlab';
      var isWarp = answers.terminal === 'warp';

      // --- Host-specific auth note ---
      var hostAuthNote = '';
      if (isGH) {
        hostAuthNote = '<p style="margin-top:0.35rem">The installer includes <strong>GitHub CLI</strong>. After setup, authenticate:</p>' +
          cmd('gh auth login') +
          '<p style="margin-top:0.25rem;font-size:0.82rem;color:var(--color-text-muted)">Choose "HTTPS" and "Login with a web browser" when prompted.</p>';
      } else if (isGL) {
        hostAuthNote = '<p style="margin-top:0.35rem">The installer includes <strong>GitLab CLI</strong>. After setup, authenticate:</p>' +
          cmd('glab auth login');
      }

      // --- Step 1: Install VibeCrew ---
      var step1 = {
        title: 'Install VibeCrew',
        summary: 'One command installs everything: Homebrew (macOS), Git, Node.js, jq, and VibeCrew itself.',
        commands: [
          { code: 'curl -fsSL https://raw.githubusercontent.com/fabkrum/vibe-crew/main/bootstrap.sh | bash' }
        ],
        more: details('What does this install?',
          checklist([
            '<strong>Homebrew</strong> &mdash; macOS package manager (also installs Xcode tools &amp; Git)',
            '<strong>Node.js</strong> &mdash; JavaScript runtime for build tools and MCP servers',
            '<strong>jq</strong> &mdash; JSON processor used by hook scripts at zero token cost',
            '<strong>VibeCrew</strong> &mdash; cloned to <code>~/claude-plugins/vibe-crew</code>'
          ]) +
          '<p style="margin-top:0.35rem">Safe to re-run anytime. Existing installs are skipped.</p>'
        ) +
        details('Prefer to inspect first?',
          '<p>Review the script, then run it locally:</p>' +
          cmd('git clone https://github.com/fabkrum/vibe-crew.git ~/claude-plugins/vibe-crew') +
          cmd('cd ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew && ./install.sh') +
          '<p style="margin-top:0.25rem;font-size:0.82rem;color:var(--color-text-muted)">This is exactly what the bootstrap script does.</p>'
        ) +
        hostAuthNote,
        show: true
      };

      // --- Step 2: Open your project ---
      var step2Commands, step2Summary;
      if (isNew) {
        step2Summary = 'Create your project folder and launch Claude Code with VibeCrew.';
        step2Commands = [
          { code: 'mkdir ~/my-project && cd ~/my-project' },
          { code: 'claude --plugin-dir ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew' }
        ];
      } else {
        step2Summary = 'Navigate to your existing project and launch Claude Code with VibeCrew.';
        step2Commands = [
          { code: 'cd ~/my-project' },
          { code: 'claude --plugin-dir ~/claude-plugins/vibe-crew/claude-plugin-vibe-crew' }
        ];
      }
      var step2 = {
        title: 'Open your project',
        summary: step2Summary,
        commands: step2Commands,
        more: '<p class="ob-guide-step-summary" style="margin-top:0.5rem;font-size:0.82rem;color:var(--color-text-muted)">Replace <code>~/my-project</code> with your actual project path.' +
          (isWarp ? ' Warp auto-detects VibeCrew and shows the plugin badge.' : '') +
          '</p>',
        show: true
      };

      // --- Step 3: Set up your environment ---
      var step3 = {
        title: 'Set up your environment',
        summary: 'Inside Claude Code, run two commands to verify your install and personalize your experience.',
        commands: [
          { code: '/setup' },
          { code: '/profile' }
        ],
        more: details('What does /setup check?',
          '<p>Verifies dependencies, detects your terminal, creates the <code>.vibecrew/</code> state directory, tests notifications, and checks Git config. Offers to fix anything missing automatically.</p>'
        ) +
        details('What are the /profile presets?',
          checklist([
            '<strong>Founder</strong> &mdash; non-technical users. Detailed explanations, supervised autonomy',
            '<strong>Builder</strong> &mdash; developers. Minimal explanations, full autonomy, auto-merge PRs',
            '<strong>Explorer</strong> &mdash; learners. Inline explanations, collaborative decisions'
          ]) +
          '<p style="margin-top:0.35rem">Controls verbosity, autonomy, PR style, code comments, and more. Change anytime.</p>'
        ),
        show: true
      };

      // --- Conditional Warp step ---
      var warpStep = {
        title: 'Get the most out of Warp',
        summary: 'VibeCrew auto-detects Warp and unlocks click-to-jump notifications, launch configs, and structured output blocks.',
        commands: [],
        more: checklist([
          '<strong>Notification deep-links</strong> &mdash; clicking a notification jumps to the right Warp tab',
          '<strong>Launch configs</strong> &mdash; <code>/setup</code> auto-generates a multi-tab layout for parallel workflows',
          '<strong>Blocks</strong> &mdash; every command is a navigable, copyable block for reviewing agent output',
          '<strong>Keyboard shortcuts</strong> &mdash; <kbd>Cmd+D</kbd> split pane, <kbd>Cmd+T</kbd> new tab, <kbd>Ctrl+Shift+R</kbd> launch config'
        ]) +
        '<p style="margin-top:0.75rem">See the full <a href="warp.html">Warp Terminal Guide &rarr;</a> for session restoration, Warp Drive, themes, Wispr Flow, and more.</p>',
        show: isWarp
      };

      // --- Step 4: Start building ---
      var step4Commands, step4Summary, step4More;
      if (isNew) {
        step4Summary = 'VibeCrew guides you through architecture decisions, then you build your first feature.';
        step4Commands = [
          { code: '/new-project' },
          { code: '/new-feature "user authentication"' }
        ];
        step4More = details('What does /new-project create?',
          checklist([
            '<strong>VISION.md</strong> &mdash; what you\'re building and who it\'s for',
            '<strong>Design system</strong> &mdash; colors, typography, spacing via a design interview',
            '<strong>Tech stack</strong> &mdash; researched technology recommendations (TDR)',
            '<strong>Architecture diagrams</strong> &mdash; visual system overview',
            '<strong>Roadmap</strong> &mdash; features in priority order',
            '<strong>CLAUDE.md</strong> &mdash; project rules for all future sessions'
          ]) +
          '<p style="margin-top:0.35rem">This is a one-time step. Every feature session after this starts instantly.</p>'
        );
      } else {
        step4Summary = 'Let VibeCrew analyze your codebase (read-only), then start building features.';
        step4Commands = [
          { code: '/onboard' },
          { code: '/new-feature "your feature name"' }
        ];
        step4More = details('What does /onboard check?',
          checklist([
            '<strong>Stack</strong> &mdash; language, framework, build tools',
            '<strong>Conventions</strong> &mdash; naming, formatters, linters, commit style',
            '<strong>Test gaps</strong> &mdash; source vs test coverage',
            '<strong>Design system</strong> &mdash; existing CSS variables, colors, spacing',
            '<strong>CLAUDE.md</strong> &mdash; auto-generated project rules'
          ]) +
          '<p style="margin-top:0.35rem">Nothing is modified. After onboarding, start building features immediately.</p>'
        );
      }
      var step4 = {
        title: 'Start building',
        summary: step4Summary,
        commands: step4Commands,
        more: step4More +
          details('What happens during the feature cycle?',
            '<p>Each feature goes through: Plan &rarr; UI Design &rarr; Code &rarr; Test &rarr; Review &rarr; Docs. Use <code>/wrap</code> to run the quality gate and commit your work.</p>'
          ),
        show: true
      };

      var allSteps = [step1, step2, step3, warpStep, step4];
      guideSteps = allSteps.filter(function(s) { return s.show; });
      currentGuideStep = 0;

      // Build pills
      var labels = {
        project: { new: 'New project', existing: 'Existing project' },
        host: { github: 'GitHub', gitlab: 'GitLab', other: 'Other host' },
        terminal: { warp: 'Warp', other: 'Other terminal' }
      };
      pills.innerHTML = '';
      ['project', 'host', 'terminal'].forEach(function(key) {
        var pill = document.createElement('span');
        pill.className = 'ob-pill';
        pill.textContent = labels[key][answers[key]];
        pills.appendChild(pill);
      });

      renderGuideStep();
      questionsPanel.classList.add('hidden');
      guidePanel.classList.remove('hidden');
    }
  })();
</script>
