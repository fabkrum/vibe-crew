---
import DocsLayout from '../layouts/DocsLayout.astro';
import AuthPatternIllustration from '../components/patterns/AuthPatternIllustration.astro';
import { authPatterns, categoryLabels, categoryOrder } from '../data/auth-patterns';
import type { AuthPattern } from '../data/auth-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = authPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof authPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<AuthPattern['category'], string> = {
  login: 'Login patterns — standard email/password forms, social OAuth, single sign-on, remember me, and secure error handling that prevents account enumeration.',
  registration: 'Registration patterns — minimal signup forms, email verification, progressive data collection, legal consent, and account linking across identity providers.',
  mfa: 'Multi-factor authentication — TOTP authenticator apps, SMS/email codes, MFA enrollment flows, and backup recovery codes for emergency access.',
  passwordless: 'Passwordless authentication — magic links, passkeys/WebAuthn, biometric authentication, and email-based one-time passwords.',
  session: 'Session management — timeout warnings, re-authentication for sensitive actions, active session lists, device management, and trusted device enrollment.',
  recovery: 'Account recovery — password reset flows, multiple recovery options, account lockout handling, and password change from authenticated state.',
  security: 'Security patterns — rate limiting feedback, CAPTCHA/bot detection, security event notifications, credential stuffing defense, and security settings pages.',
};
---

<DocsLayout title="Authentication Patterns" sectionLabel="Reference" activeSlug="auth-patterns">

  <h2>Authentication Patterns</h2>
  <p>Research-backed patterns for authentication systems that VibeCrew agents apply when building login, registration, MFA, and security features. Each pattern includes implementation guidance, accessibility requirements, and anti-patterns based on NN/G, OWASP, NIST, Baymard Institute, and WCAG research.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+]/g, '-')}>
            <div class="pattern-card-inner">
              <AuthPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Add login"</td><td>Login Form + Social OAuth + Login Error Handling + Remember Me + Password Reset Flow + ARIA labels + focus management</td></tr>
        <tr><td>"Add signup"</td><td>Signup Form + Email Verification + Terms & Consent + Progressive Registration + password strength meter + Social OAuth</td></tr>
        <tr><td>"Add two-factor auth"</td><td>MFA Enrollment + TOTP Authenticator + SMS/Email OTP fallback + Backup Recovery Codes + Trusted Devices</td></tr>
        <tr><td>"Use passkeys"</td><td>Passkeys/WebAuthn registration + Biometric Authentication + fallback to password + passkey management in security settings</td></tr>
        <tr><td>"Add SSO"</td><td>Single Sign-On domain detection + SAML/OIDC integration + Account Linking for existing users + SSO-specific error handling</td></tr>
        <tr><td>"Secure the login"</td><td>Rate Limiting Feedback + CAPTCHA/Bot Detection + Credential Stuffing Defense + Account Lockout + Security Event Notifications</td></tr>
        <tr><td>"Add session management"</td><td>Session Timeout Warning + Re-Authentication for sensitive actions + Active Sessions/Device Management + Trusted Devices</td></tr>
        <tr><td>"Add account settings"</td><td>Security Settings Page + Password Change + MFA management + Active Sessions + Trusted Devices + danger zone</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement authentication systems. They are referenced here rather than duplicated — click through for full details.</p>
    <ul class="related-links">
      <li><a href="/form-patterns#input-otp">Input OTP</a> &mdash; OTP input component for verification codes (Form Patterns)</li>
      <li><a href="/form-patterns#password-strength">Password Strength</a> &mdash; Password strength meter and reveal toggle (Form Patterns)</li>
      <li><a href="/business-patterns#progressive-profiling">Progressive Profiling</a> &mdash; Gradual data collection during onboarding (Business Patterns)</li>
      <li><a href="/business-patterns#guest-checkout">Guest Checkout</a> &mdash; Delaying account creation until after value (Business Patterns)</li>
      <li><a href="/notification-patterns#toast---snackbar">Toast / Snackbar</a> &mdash; Success/error feedback for auth actions (Notification Patterns)</li>
      <li><a href="/notification-patterns#email-notification">Email Notification</a> &mdash; Transactional emails for verification and security alerts (Notification Patterns)</li>
      <li><a href="/ui-patterns#dialog">Dialog</a> &mdash; Modal dialogs for re-authentication and session warnings (UI Patterns)</li>
      <li><a href="/dark-patterns#forced-account-creation">Forced Account Creation</a> &mdash; Anti-pattern of requiring signup before showing value (Dark Patterns)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://www.nngroup.com/articles/checklist-registration-login/" target="_blank" rel="noopener noreferrer">NN/G: A Checklist for Registration and Login Forms on Mobile</a> &mdash; Comprehensive usability checklist for auth forms</li>
      <li><a href="https://www.nngroup.com/articles/passwordless-accounts/" target="_blank" rel="noopener noreferrer">NN/G: Passwordless Accounts: OTPs and Passkeys</a> &mdash; Research on passwordless authentication UX</li>
      <li><a href="https://www.nngroup.com/articles/password-creation/" target="_blank" rel="noopener noreferrer">NN/G: Password Creation: 3 Ways To Make It Easier</a> &mdash; Password field UX best practices</li>
      <li><a href="https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer">OWASP: Authentication Cheat Sheet</a> &mdash; Security implementation reference</li>
      <li><a href="https://pages.nist.gov/800-63-3/sp800-63b.html" target="_blank" rel="noopener noreferrer">NIST SP 800-63B: Digital Identity Guidelines</a> &mdash; Federal authentication security standards</li>
      <li><a href="https://workos.com/guide/ui-ux-best-practices-for-idp-and-sp-initiated-sso" target="_blank" rel="noopener noreferrer">WorkOS: UI/UX Best Practices for SSO</a> &mdash; Enterprise SSO design patterns</li>
      <li><a href="https://blog.logrocket.com/ux-design/creating-painless-2fa-user-flow" target="_blank" rel="noopener noreferrer">LogRocket: How to Design 2FA User Flows</a> &mdash; MFA UX design guide</li>
      <li><a href="https://ui.shadcn.com/docs/components/radix/input-otp" target="_blank" rel="noopener noreferrer">shadcn/ui: Input OTP</a> &mdash; OTP input component reference</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
