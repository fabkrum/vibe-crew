---
import DocsLayout from '../layouts/DocsLayout.astro';
import ResponsivePatternIllustration from '../components/patterns/ResponsivePatternIllustration.astro';
import { responsivePatterns, categoryLabels, categoryOrder } from '../data/responsive-patterns';
import type { ResponsivePattern } from '../data/responsive-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = responsivePatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof responsivePatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<ResponsivePattern['category'], string> = {
  strategy: 'Mobile-first CSS strategy, content-driven breakpoints, and progressive enhancement — the foundational principles for responsive design.',
  breakpoints: 'Viewport breakpoints, container queries, and input detection — choosing the right responsive mechanism for each context.',
  typography: 'Fluid type sizing with clamp(), fluid spacing, and line length control — typography that scales smoothly across all viewports.',
  images: 'Responsive images with srcset, art direction with picture, aspect ratio preservation, and lazy loading — optimized media delivery.',
  layout: 'CSS Grid auto-fill, flex wrap, logical properties, sidebar layouts, and stack-to-row — responsive layout building blocks.',
  navigation: 'Navigation patterns that adapt across desktop, tablet, and mobile — horizontal bars, priority+, off-canvas drawers, and responsive tables.',
};
---

<DocsLayout title="Responsive Design Patterns" sectionLabel="Reference" activeSlug="responsive-patterns">

  <h2>Responsive Design Patterns</h2>
  <p>22 patterns for building responsive, adaptive interfaces that work across every viewport and input method. Each pattern covers mobile-first CSS strategy, fluid sizing, responsive images, and adaptive navigation — so VibeCrew agents produce layouts that look great on every device.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+]/g, '-')}>
            <div class="pattern-card-inner">
              <ResponsivePatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Make it responsive"</td><td>Mobile-First CSS + Standard Breakpoints + Touch Targets + Fluid Typography + Responsive Images</td></tr>
        <tr><td>"Add a card grid"</td><td>Auto-Fill Grid with minmax(280px, 1fr) + aspect-ratio on images + lazy loading below fold</td></tr>
        <tr><td>"Text should scale nicely"</td><td>Clamp-Based Font Sizing + Line Length Control (max-width: 65ch) + Fluid Spacing</td></tr>
        <tr><td>"Optimize images"</td><td>srcset + sizes + Art Direction + Aspect Ratio Preservation + Lazy Loading + fetchpriority</td></tr>
        <tr><td>"Navigation for mobile"</td><td>Bottom Tab Bar (3-5 items) or Off-Canvas Drawer (5+) + Priority+ for tablet</td></tr>
        <tr><td>"Support RTL languages"</td><td>Logical Properties (margin-inline, padding-block) + dir="rtl" attribute</td></tr>
        <tr><td>"A table that works on mobile"</td><td>Responsive Table with horizontal scroll + card transformation fallback</td></tr>
        <tr><td>"Sidebar layout"</td><td>CSS Grid sidebar (260px + 1fr) desktop, stacked 1fr mobile + Container Queries for widgets</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement responsive design. They are referenced here rather than duplicated — click through for full details.</p>
    <ul class="related-links">
      <li><a href="/mobile-patterns#thumb-zone-design">Thumb Zone Design</a> &mdash; Mobile ergonomics and one-handed reachability (Mobile &amp; Touch Patterns)</li>
      <li><a href="/mobile-patterns#safe-area-insets">Safe Area Insets</a> &mdash; Device notch and home indicator handling (Mobile &amp; Touch Patterns)</li>
      <li><a href="/mobile-patterns#dynamic-viewport-height">Dynamic Viewport Height</a> &mdash; 100dvh vs 100vh for mobile (Mobile &amp; Touch Patterns)</li>
      <li><a href="/mobile-patterns#bottom-tab-bar">Bottom Tab Bar</a> &mdash; Mobile-first navigation (Mobile &amp; Touch Patterns)</li>
      <li><a href="/media-patterns">Media Patterns</a> &mdash; Image optimization, video players, and lazy loading strategies (Media Patterns)</li>
      <li><a href="/ui-patterns#data-table">Data Table</a> &mdash; Sortable, filterable tables (UI Patterns)</li>
      <li><a href="/i18n-guide">i18n Guide</a> &mdash; RTL support and logical properties in context (i18n Guide)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://web.dev/articles/responsive-web-design-basics" target="_blank" rel="noopener noreferrer">web.dev: Responsive Web Design Basics</a> &mdash; Google's responsive design fundamentals</li>
      <li><a href="https://utopia.fyi/" target="_blank" rel="noopener noreferrer">Utopia: Fluid Type & Space Calculator</a> &mdash; Generate fluid type and spacing scales</li>
      <li><a href="https://every-layout.dev/" target="_blank" rel="noopener noreferrer">Every Layout</a> &mdash; Intrinsic, responsive layout primitives</li>
      <li><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_containment/Container_queries" target="_blank" rel="noopener noreferrer">MDN: Container Queries</a> &mdash; Container query specification and examples</li>
      <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html" target="_blank" rel="noopener noreferrer">W3C: WCAG 2.5.8 Target Size</a> &mdash; Touch target sizing requirements</li>
      <li><a href="https://web.dev/articles/responsive-images" target="_blank" rel="noopener noreferrer">web.dev: Responsive Images</a> &mdash; Complete guide to srcset, sizes, and picture</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); overflow: hidden; }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); overflow-wrap: break-word; }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
