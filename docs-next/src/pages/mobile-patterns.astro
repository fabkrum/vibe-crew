---
import DocsLayout from '../layouts/DocsLayout.astro';
import MobilePatternIllustration from '../components/patterns/MobilePatternIllustration.astro';
import { mobilePatterns, categoryLabels, categoryOrder } from '../data/mobile-patterns';
import type { MobilePattern } from '../data/mobile-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = mobilePatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof mobilePatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<MobilePattern['category'], string> = {
  touch: 'Touch target sizing, thumb zone placement, spacing, and input ergonomics — the foundation of usable mobile interfaces.',
  navigation: 'Mobile navigation patterns — bottom tabs, drawers, back buttons, collapsing headers, and bottom sheets for in-thumb-reach navigation.',
  gestures: 'Gesture-driven interactions — swipe actions, pull to refresh, long press, pinch zoom, and haptic feedback for native-feeling mobile experiences.',
  layout: 'Safe area handling, dynamic viewport units, one-handed reachability, and zoom prevention — the CSS foundations for mobile-correct layouts.',
  feedback: 'Mobile feedback patterns — stories format, pull-down banners, and skeleton loading for responsive, native-feeling content presentation.',
  content: 'Content patterns commonly used on mobile — timelines, star ratings, steppers, dark mode toggles, and back-to-top buttons.',
  utilities: 'Utility components for mobile — share sheets, swipeable card stacks, and horizontal scroll with snap for touch-first interactions.',
};
---

<DocsLayout title="Mobile & Touch Patterns" sectionLabel="Reference" activeSlug="mobile-patterns">

  <h2>Mobile & Touch Patterns</h2>
  <p>32 research-backed patterns for building mobile-first, touch-friendly interfaces. Each pattern covers thumb-zone ergonomics, gesture handling, safe-area compliance, and accessibility — so VibeCrew agents produce interfaces that feel native on every device.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+]/g, '-')}>
            <div class="pattern-card-inner">
              <MobilePatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Make it mobile-friendly"</td><td>Touch Target Sizing + Bottom Tab Bar + Safe Area Insets + Dynamic Viewport Height + Input Field Sizing</td></tr>
        <tr><td>"Add a menu"</td><td>Bottom Tab Bar (3-5 items) or Drawer Navigation (5+ items) + Back Navigation + safe-area padding</td></tr>
        <tr><td>"Swipeable list"</td><td>Swipe Left/Right + 80px threshold + red/green action reveal + visible button fallback</td></tr>
        <tr><td>"Pull to refresh"</td><td>Pull to Refresh + overscroll-behavior + 64px threshold + Refresh button alternative + aria-live</td></tr>
        <tr><td>"Stories like Instagram"</td><td>Stories Format + progress bars + tap zones + auto-advance + prefers-reduced-motion pause</td></tr>
        <tr><td>"Add sharing"</td><td>Share Sheet with navigator.share() + Copy Link fallback + bottom action sheet</td></tr>
        <tr><td>"A card swiping UI"</td><td>Swipeable Card Stack + rotation transform + arrow button alternatives + keyboard support</td></tr>
        <tr><td>"Dark mode"</td><td>Dark Mode Toggle (System/Light/Dark) + prefers-color-scheme + localStorage + CSS custom properties</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement mobile &amp; touch interfaces. They are referenced here rather than duplicated — click through for full details.</p>
    <ul class="related-links">
      <li><a href="/filter-search-patterns#bottom-sheet-filters">Bottom Sheet Filters</a> &mdash; Mobile filter panels using bottom sheets (Filter &amp; Search Patterns)</li>
      <li><a href="/filter-search-patterns#horizontal-scroll-chips">Horizontal Scroll Chips</a> &mdash; Mobile filter chip scrolling (Filter &amp; Search Patterns)</li>
      <li><a href="/ui-patterns#drawer">Drawer</a> &mdash; Slide-out panel component (UI Patterns)</li>
      <li><a href="/ui-patterns#toast">Toast</a> &mdash; Transient notification component (UI Patterns)</li>
      <li><a href="/form-patterns#mobile-keyboard-types">Mobile Keyboard Types</a> &mdash; Input type optimization for mobile keyboards (Form Patterns)</li>
      <li><a href="/animation-patterns#scroll-triggered-animations">Scroll-Triggered Animations</a> &mdash; IntersectionObserver-based animations (Animation Patterns)</li>
      <li><a href="/ui-patterns#responsive-navigation">Responsive Navigation</a> &mdash; Desktop-to-mobile navigation adaptation (UI Patterns)</li>
      <li><a href="/notification-patterns#toast-notification">Toast Notification</a> &mdash; Dismissible notification patterns (Notification Patterns)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html" target="_blank" rel="noopener noreferrer">W3C: WCAG 2.5.8 Target Size</a> &mdash; Minimum touch target size requirements</li>
      <li><a href="https://m3.material.io/foundations/interaction/touch-input" target="_blank" rel="noopener noreferrer">Material Design 3: Touch Input</a> &mdash; Touch target and gesture guidelines</li>
      <li><a href="https://developer.apple.com/design/human-interface-guidelines/gestures" target="_blank" rel="noopener noreferrer">Apple HIG: Gestures</a> &mdash; iOS gesture design guidelines</li>
      <li><a href="https://web.dev/articles/viewport-units" target="_blank" rel="noopener noreferrer">web.dev: Viewport Units</a> &mdash; Dynamic viewport units (dvh, svh, lvh)</li>
      <li><a href="https://www.nngroup.com/articles/bottom-sheet/" target="_blank" rel="noopener noreferrer">NN/G: Bottom Sheets</a> &mdash; Research on mobile bottom sheet usability</li>
      <li><a href="https://www.smashingmagazine.com/2022/01/designing-better-mobile-navigation-ux/" target="_blank" rel="noopener noreferrer">Smashing: Mobile Navigation UX</a> &mdash; Mobile navigation best practices</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); overflow: hidden; }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); overflow-wrap: break-word; }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
