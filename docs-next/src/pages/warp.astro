    .layout-diagram { display: flex; gap: 2px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.85rem; }
