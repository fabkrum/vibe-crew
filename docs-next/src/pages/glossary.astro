---
import DocsLayout from '../layouts/DocsLayout.astro';
import Badge from '../components/Badge.astro';
import GlossaryIllustration from '../components/glossary/GlossaryIllustration.astro';
import { glossary, glossaryCategoryColors, glossaryCategories } from '../data/glossary';

// Group terms alphabetically
const grouped = glossary.reduce((acc, term) => {
  const letter = term.term[0].toUpperCase();
  if (!acc[letter]) acc[letter] = [];
  acc[letter].push(term);
  return acc;
}, {} as Record<string, typeof glossary>);

const letters = Object.keys(grouped).sort();
---

<DocsLayout title="Glossary" sectionLabel="Reference" activeSlug="glossary">

  <h2>Glossary</h2>
  <p>Key terms and concepts used throughout VibeCrew. Click a letter to jump to that section.</p>

  <div class="letter-nav">
    {letters.map((letter) => (
      <a href={`#letter-${letter}`}>{letter}</a>
    ))}
  </div>

  {letters.map((letter) => (
    <section class="glossary-section" id={`letter-${letter}`}>
      <h3 class="letter-heading">{letter}</h3>
      <dl class="glossary-list">
        {grouped[letter].map((entry) => (
          <div class="glossary-entry" id={entry.term.toLowerCase().replace(/[\s\/]/g, '-')}>
            <div class="glossary-entry-inner">
              <div class="glossary-illustration-wrap">
                <GlossaryIllustration name={entry.term} />
              </div>
              <div class="glossary-content">
                <dt>
                  {entry.term}
                  <Badge color={glossaryCategoryColors[entry.category]} text={glossaryCategories[entry.category]} />
                </dt>
                <dd set:html={entry.definition} />
                {entry.learnMoreUrl && (
                  <a class="learn-more" href={entry.learnMoreUrl} target="_blank" rel="noopener noreferrer">
                    {entry.learnMoreLabel || 'Learn more'} &rarr;
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </dl>
    </section>
  ))}
</DocsLayout>

<style>
  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .letter-nav a {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-xs);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
  }

  .letter-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .letter-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    margin-top: 2rem;
  }

  .glossary-list {
    margin: 0 0 2rem;
  }

  .glossary-entry {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .glossary-entry:last-child {
    border-bottom: none;
  }

  .glossary-entry-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .glossary-illustration-wrap {
    flex-shrink: 0;
    width: 200px;
    padding: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }

  .glossary-content {
    flex: 1;
    min-width: 0;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .learn-more {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .learn-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .glossary-entry-inner {
      flex-direction: column;
    }

    .glossary-illustration-wrap {
      width: 100%;
      max-width: 240px;
    }
  }
</style>
