    "firebase": {
      "name": "Firebase",
      "description": "App platform with Firestore, auth, hosting, and cloud functions",
      "category": "database",
      "patterns": ["firebase", "firestore"],
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "mcp"],
      "env": {},
      "docs_url": "https://firebase.google.com/docs/cli#mcp"
    },
    "prisma": {
      "name": "Prisma",
      "description": "Type-safe ORM for PostgreSQL, MySQL, SQLite, and more",
      "category": "database",
      "patterns": ["prisma", "drizzle"],
      "command": "npx",
      "args": ["-y", "prisma", "mcp"],
      "env": {},
      "docs_url": "https://www.prisma.io/docs"
