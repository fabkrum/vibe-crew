<script is:inline>
  (function() {
    var tabs = document.querySelectorAll('.arch-tab');
    var panels = document.querySelectorAll('.arch-panel');
    var rendered = {};

    // Build ordered tab list for prev/next navigation
    var tabOrder = [];
    var tabLabels = {};
    tabs.forEach(function(t) {
      var key = t.getAttribute('data-tab');
      tabOrder.push(key);
      tabLabels[key] = t.textContent.trim();
    });

    var prevBtn = document.getElementById('tab-prev');
    var nextBtn = document.getElementById('tab-next');
    var prevTitle = document.getElementById('tab-prev-title');
    var nextTitle = document.getElementById('tab-next-title');

    function updateNavButtons(target) {
      var idx = tabOrder.indexOf(target);
      if (prevBtn && nextBtn) {
        // Previous button
        if (idx <= 0) {
          prevBtn.disabled = true;
          prevTitle.textContent = '';
        } else {
          prevBtn.disabled = false;
          prevTitle.textContent = tabLabels[tabOrder[idx - 1]];
        }
        // Next button
        if (idx >= tabOrder.length - 1) {
          nextBtn.disabled = true;
          nextTitle.textContent = '';
        } else {
          nextBtn.disabled = false;
          nextTitle.textContent = tabLabels[tabOrder[idx + 1]];
        }
      }
    }

    function switchTab(target) {
      // Update tabs
      tabs.forEach(function(t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      var activeTab = document.querySelector('[data-tab="' + target + '"]');
      if (activeTab) {
        activeTab.classList.add('active');
        activeTab.setAttribute('aria-selected', 'true');
        // Scroll the active tab into view in the scrollable tab bar
        activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      }

      // Update panels
      panels.forEach(function(p) {
        p.classList.remove('active');
        p.hidden = true;
      });
      var panel = document.getElementById('panel-' + target);
      if (panel) {
        panel.classList.add('active');
        panel.hidden = false;

        // Render mermaid diagrams on first show (startOnLoad is false)
        if (!rendered[target] && window.mermaid) {
          rendered[target] = true;
          var pres = panel.querySelectorAll('pre.mermaid');
          if (pres.length > 0) {
            requestAnimationFrame(function() {
              mermaid.run({ nodes: pres });
            });
          }
        }
      }

      // Update prev/next buttons
      updateNavButtons(target);
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        switchTab(tab.getAttribute('data-tab'));
      });
    });

    // Prev/next button click handlers
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        var current = document.querySelector('.arch-tab.active');
        if (!current) return;
        var idx = tabOrder.indexOf(current.getAttribute('data-tab'));
        if (idx > 0) switchTab(tabOrder[idx - 1]);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        var current = document.querySelector('.arch-tab.active');
        if (!current) return;
        var idx = tabOrder.indexOf(current.getAttribute('data-tab'));
        if (idx < tabOrder.length - 1) switchTab(tabOrder[idx + 1]);
      });
    }

    // Initialize nav buttons for the first tab
    updateNavButtons(tabOrder[0]);

    // Skills category filter
    var pills = document.querySelectorAll('.filter-pill');
    var skillRows = document.querySelectorAll('#skills-table tbody tr');
    pills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        pills.forEach(function(p) { p.classList.remove('active'); });
        pill.classList.add('active');
        var cat = pill.getAttribute('data-cat');
        skillRows.forEach(function(row) {
          var match = cat === 'all' || row.getAttribute('data-cat') === cat;
          row.style.display = match ? '' : 'none';
        });
      });
    });
  })();
</script>
