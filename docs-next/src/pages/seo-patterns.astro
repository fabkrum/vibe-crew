---
import DocsLayout from '../layouts/DocsLayout.astro';
import SeoPatternIllustration from '../components/patterns/SeoPatternIllustration.astro';
import { seoPatterns, categoryLabels, categoryOrder } from '../data/seo-patterns';
import type { SeoPattern } from '../data/seo-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = seoPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof seoPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<SeoPattern['category'], string> = {
  technical: 'Technical SEO foundations -- canonical URLs, XML sitemaps, robots.txt, clean URL hierarchies, and Core Web Vitals that form the crawling and indexing baseline for search engines and AI agents.',
  meta: 'Meta tag patterns -- Open Graph, Twitter Cards, meta descriptions, robots directives, and favicon/manifest configurations that control how pages appear in search results and shared links.',
  structured_data: 'Structured data patterns -- JSON-LD schemas for websites, breadcrumbs, articles, software, FAQs, and tutorials that enable rich results and help AI agents understand content semantics.',
  ai_discovery: 'AI agent discovery patterns -- llms.txt, AI-friendly content structure, AI bot directives, and semantic HTML that make content discoverable and extractable by LLM-powered tools and agents.',
  content: 'Content SEO patterns -- heading hierarchy, internal linking strategy, image optimization, and anchor-based deep linking that improve both search ranking and content accessibility.',
  sharing: 'Social and sharing SEO patterns -- OG image generation, share URL hygiene, and rich link preview testing that ensure shared links display correctly across platforms.',
  monitoring: 'Monitoring and validation patterns -- structured data testing and Search Console integration that provide ongoing feedback on indexing, coverage, and search performance.',
  performance: 'HTTP caching strategies -- Cache-Control directives for HTML, fingerprinted assets, API data, and images. Proper caching directly impacts Core Web Vitals, repeat-visit performance, and server costs.',
};
---

<DocsLayout title="SEO &amp; AI Discoverability Patterns" sectionLabel="Reference" activeSlug="seo-patterns">

  <h2>SEO &amp; AI Discoverability Patterns</h2>
  <p>Patterns for making content discoverable by both search engines and AI agents. VibeCrew agents apply these when building landing pages, documentation, blogs, and any public-facing content. Every pattern prioritizes standards-based approaches: structured data serves both audiences, semantic HTML benefits crawlers, AI agents, and screen readers equally. Based on Schema.org, Open Graph Protocol, llmstxt.org, Google Search Central, and Core Web Vitals research.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+@"=.]/g, '-')}>
            <div class="pattern-card-inner">
              <SeoPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Make the site SEO-friendly"</td><td>Canonical URL + XML Sitemap + robots.txt + Meta Description + Open Graph Tags + JSON-LD WebSite Schema</td></tr>
        <tr><td>"I want rich snippets in Google"</td><td>Article Schema (with dateModified) + BreadcrumbList Schema + FAQ Schema on Q&amp;A pages + Product Schema on pricing pages</td></tr>
        <tr><td>"Make our docs discoverable by AI assistants"</td><td>llms.txt + llms-full.txt (build-time generated) + AI-Friendly Content Structure + Semantic HTML landmarks</td></tr>
        <tr><td>"Pages should look good when shared"</td><td>Open Graph Tags + Twitter/X Cards + OG Image Generation (per-page) + Share URL Hygiene</td></tr>
        <tr><td>"Add a product page for app stores"</td><td>SoftwareApplication Schema + Product Schema + Favicon &amp; App Manifest + Meta Description</td></tr>
        <tr><td>"Optimize the blog for search"</td><td>Article Schema + Heading Hierarchy + Internal Linking + Image SEO + Canonical URL + Anchor-Based Deep Linking</td></tr>
        <tr><td>"We're hosting a launch event"</td><td>Event Schema + Organization Schema + Open Graph Tags + Meta Description</td></tr>
        <tr><td>"Add our company info to Google"</td><td>Organization Schema + JSON-LD WebSite Schema + Favicon &amp; App Manifest</td></tr>
        <tr><td>"Embed tutorial videos"</td><td>VideoObject Schema + HowTo Schema + Image SEO + Heading Hierarchy</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement SEO and discoverability. They are referenced here rather than duplicated -- click through for full details.</p>
    <ul class="related-links">
      <li><a href="/social-patterns#schema-org-sameas">Schema.org sameAs</a> &mdash; Social identity structured data connecting your site to social profiles (Social Media Patterns)</li>
      <li><a href="/social-patterns#static-share-link">Static Share Links</a> &mdash; Share buttons that use OG metadata for pre-populated content (Social Media Patterns)</li>
      <li><a href="/business-patterns#social-proof">Social Proof</a> &mdash; Social proof elements that benefit from structured data markup (Business Patterns)</li>
      <li><a href="/auth-patterns#session-handling">Session Handling</a> &mdash; Session IDs that must not leak into canonical URLs (Authentication Patterns)</li>
      <li><a href="/form-patterns#search-input">Search Input</a> &mdash; Site search that powers the SearchAction schema (Form Patterns)</li>
      <li><a href="/onboarding-patterns#empty-state">Empty States</a> &mdash; Empty states and utility pages that should be noindexed (Onboarding Patterns)</li>
      <li><a href="/media-patterns#image-optimization">Image Optimization</a> &mdash; WebP/AVIF conversion, srcset, and compression for Image SEO (Media Patterns)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://llmstxt.org/" target="_blank" rel="noopener noreferrer">llmstxt.org</a> &mdash; The llms.txt specification for AI agent discovery of website content</li>
      <li><a href="https://schema.org/" target="_blank" rel="noopener noreferrer">Schema.org</a> &mdash; The collaborative vocabulary for structured data on the web</li>
      <li><a href="https://developers.google.com/search/docs" target="_blank" rel="noopener noreferrer">Google Search Central</a> &mdash; Official Google documentation for structured data, indexing, and search features</li>
      <li><a href="https://ogp.me/" target="_blank" rel="noopener noreferrer">Open Graph Protocol</a> &mdash; The OGP specification for social sharing metadata</li>
      <li><a href="https://web.dev/articles/vitals" target="_blank" rel="noopener noreferrer">web.dev: Core Web Vitals</a> &mdash; LCP, INP, and CLS measurement and optimization guides</li>
      <li><a href="https://search.google.com/test/rich-results" target="_blank" rel="noopener noreferrer">Google Rich Results Test</a> &mdash; Validate structured data and preview rich result eligibility</li>
      <li><a href="https://www.robotstxt.org/" target="_blank" rel="noopener noreferrer">robotstxt.org</a> &mdash; The robots.txt specification and best practices</li>
      <li><a href="https://developer.x.com/en/docs/x-for-websites/cards/overview/abouts-cards" target="_blank" rel="noopener noreferrer">Twitter/X Cards</a> &mdash; Twitter Card tag specification and card types</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); overflow: hidden; }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); overflow-wrap: break-word; }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
