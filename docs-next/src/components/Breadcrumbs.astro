---
import { getSectionLabel } from '../data/navigation';
import { url } from '../data/site';

interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
const section = getSectionLabel(slug);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={url('/index.html')}>Home</a>
  {section && (
    <>
      <span class="separator">/</span>
      <span>{section}</span>
    </>
  )}
  <span class="separator">/</span>
  <span>{title}</span>
</nav>

<!-- Schema.org BreadcrumbList -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://vibecrew.dev/" },
    ...(section ? [{ "@type": "ListItem", "position": 2, "name": section }] : []),
    { "@type": "ListItem", "position": section ? 3 : 2, "name": title },
  ],
})} />
