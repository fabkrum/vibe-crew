      "category": "auth",
      "patterns": ["auth0"],
      "command": "npx",
      "args": ["-y", "@auth0/auth0-mcp-server", "run"],
      "env": {},
      "docs_url": "https://auth0.com/docs"
    },
    "netlify": {
      "name": "Netlify",
      "description": "Web hosting, serverless functions, and edge deployment",
      "category": "hosting",
      "patterns": ["netlify"],
      "command": "npx",
      "args": ["-y", "@netlify/mcp"],
      "env": {},
      "docs_url": "https://docs.netlify.com/"
    },
    "railway": {
      "name": "Railway",
      "description": "Infrastructure platform for deploying apps and databases",
      "category": "hosting",
      "patterns": ["railway"],
      "command": "npx",
      "args": ["-y", "@railway/mcp-server"],
      "env": {},
      "docs_url": "https://docs.railway.com/"
    },
    "shopify": {
      "name": "Shopify",
      "description": "E-commerce platform, storefronts, and Hydrogen framework",
      "category": "e-commerce",
      "patterns": ["shopify"],
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"],
