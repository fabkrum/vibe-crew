---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';

interface Props {
  title: string;
  description?: string;
  sectionLabel?: string;
  activeSlug: string;
  wide?: boolean;
  hideBreadcrumbs?: boolean;
  hideNav?: boolean;
}

const { title, description, sectionLabel, activeSlug, wide = false, hideBreadcrumbs = false, hideNav = false } = Astro.props;
---

<BaseLayout title={`VibeCrew — ${title}`} description={description} activeSlug={activeSlug}>
  <div class="main" data-pagefind-body>
    {!hideBreadcrumbs && <Breadcrumbs title={title} slug={activeSlug} />}
    <slot />
    {!hideNav && <PrevNext slug={activeSlug} />}
  </div>
</BaseLayout>
