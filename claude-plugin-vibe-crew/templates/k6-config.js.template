// Generated by VibeCrew — k6 performance test configuration
// Usage: k6 run perf-tests/<test-name>.js
// Docs: https://grafana.com/docs/k6/latest/

import http from 'k6/http';
import { check, sleep } from 'k6';
import { Rate, Trend } from 'k6/metrics';

// --- Custom Metrics ---
const errorRate = new Rate('errors');
const responseTime = new Trend('response_time');

// --- Configuration ---
// Replace TARGET_URL with the actual endpoint under test.
const BASE_URL = __ENV.BASE_URL || 'http://localhost:3000';
const ENDPOINT = __ENV.ENDPOINT || '/';

// --- Test Profiles ---
// Uncomment ONE profile block or set via K6_TEST_TYPE env var.

const profiles = {
  // Load test: sustained traffic at expected production level
  load: {
    stages: [
      { duration: '1m', target: 20 },   // ramp up
      { duration: '3m', target: 20 },   // hold
      { duration: '1m', target: 0 },    // ramp down
    ],
  },

  // Stress test: find the breaking point
  stress: {
    stages: [
      { duration: '1m', target: 20 },
      { duration: '2m', target: 50 },
      { duration: '2m', target: 100 },
      { duration: '2m', target: 150 },
      { duration: '1m', target: 0 },
    ],
  },

  // Spike test: sudden burst of traffic
  spike: {
    stages: [
      { duration: '30s', target: 5 },
      { duration: '10s', target: 200 },  // spike
      { duration: '1m', target: 200 },   // hold spike
      { duration: '10s', target: 5 },    // drop
      { duration: '1m', target: 5 },     // recovery
    ],
  },

  // Soak test: extended duration at moderate load
  soak: {
    stages: [
      { duration: '2m', target: 30 },
      { duration: '30m', target: 30 },   // sustained
      { duration: '2m', target: 0 },
    ],
  },
};

const testType = __ENV.K6_TEST_TYPE || 'load';

export const options = {
  stages: profiles[testType]?.stages || profiles.load.stages,

  thresholds: {
    // Default thresholds — adjust per project
    http_req_duration: ['p(95)<500', 'p(99)<1000'],  // p95 < 500ms, p99 < 1s
    errors: ['rate<0.01'],                             // error rate < 1%
    http_req_failed: ['rate<0.01'],                    // HTTP failure rate < 1%
  },
};

// --- Test Script ---
export default function () {
  const url = `${BASE_URL}${ENDPOINT}`;
  const res = http.get(url);

  // Track custom metrics
  responseTime.add(res.timings.duration);
  errorRate.add(res.status >= 400);

  // Assertions
  check(res, {
    'status is 200': (r) => r.status === 200,
    'response time < 500ms': (r) => r.timings.duration < 500,
    'response body is not empty': (r) => r.body && r.body.length > 0,
  });

  sleep(1);
}

// --- Lifecycle Hooks ---
export function handleSummary(data) {
  // Output JSON summary for VibeCrew to parse
  return {
    stdout: JSON.stringify({
      test_type: testType,
      timestamp: new Date().toISOString(),
      metrics: {
        http_req_duration_p95: data.metrics?.http_req_duration?.values?.['p(95)'] || 0,
        http_req_duration_p99: data.metrics?.http_req_duration?.values?.['p(99)'] || 0,
        http_req_duration_avg: data.metrics?.http_req_duration?.values?.avg || 0,
        http_reqs_rate: data.metrics?.http_reqs?.values?.rate || 0,
        error_rate: data.metrics?.errors?.values?.rate || 0,
        http_req_failed_rate: data.metrics?.http_req_failed?.values?.rate || 0,
        vus_max: data.metrics?.vus_max?.values?.max || 0,
        iterations: data.metrics?.iterations?.values?.count || 0,
      },
      thresholds: Object.fromEntries(
        Object.entries(data.root_group?.thresholds || data.thresholds || {}).map(
          ([key, val]) => [key, val.ok ?? val]
        )
      ),
    }, null, 2) + '\n',
  };
}
