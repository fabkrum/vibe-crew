---
import DocsLayout from '../layouts/DocsLayout.astro';
import TableWrap from '../components/TableWrap.astro';
import { commands, categories } from '../data/commands';
---

<DocsLayout title="Slash Commands" sectionLabel="Reference" activeSlug="commands">

  <h2>Slash Commands Reference</h2>
  <p>All 31 VibeCrew slash commands with their agents, tier requirements, and descriptions. Use the filter tabs or search to find what you need.</p>

  <div class="command-controls">
    <div class="filter-tabs" id="filter-tabs">
      <button class="filter-tab active" data-category="all">All</button>
      {categories.map((cat) => (
        <button class="filter-tab" data-category={cat}>{cat}</button>
      ))}
    </div>
    <div class="command-search-wrap">
      <input type="text" class="command-search" id="command-search" placeholder="Search commands..." aria-label="Search commands" />
    </div>
  </div>

  <TableWrap>
    <table id="commands-table">
      <thead>
        <tr>
          <th>Command</th>
          <th>Category</th>
          <th>Agent(s)</th>
          <th>Tier</th>
          <th>Purpose</th>
        </tr>
      </thead>
      <tbody>
        {commands.map((cmd) => (
          <tr data-category={cmd.category}>
            <td><code>{cmd.name}{cmd.args ? ` ${cmd.args}` : ''}</code></td>
            <td><span class="badge purple">{cmd.category}</span></td>
            <td>{cmd.agent}</td>
            <td>{cmd.tier}</td>
            <td>{cmd.purpose}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableWrap>
</DocsLayout>

<style>
  .command-controls {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-tab {
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-sans);
  }

  .filter-tab:hover {
    color: var(--color-text);
    border-color: var(--color-accent-dim);
  }

  .filter-tab.active {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    border-color: rgba(167, 139, 250, 0.2);
  }

  .command-search-wrap {
    max-width: 300px;
  }

  .command-search {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.85rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s;
  }

  .command-search:focus {
    border-color: var(--color-accent);
  }

  .command-search::placeholder {
    color: var(--color-text-muted);
  }

  tr.hidden {
    display: none;
  }
</style>

<script is:inline>
  (function() {
    var tabs = document.querySelectorAll('.filter-tab');
    var search = document.getElementById('command-search');
    var rows = document.querySelectorAll('#commands-table tbody tr');
    var activeCategory = 'all';

    function filterRows() {
      var query = (search.value || '').toLowerCase();
      rows.forEach(function(row) {
        var cat = row.getAttribute('data-category');
        var text = row.textContent.toLowerCase();
        var catMatch = activeCategory === 'all' || cat === activeCategory;
        var searchMatch = !query || text.indexOf(query) !== -1;
        row.classList.toggle('hidden', !(catMatch && searchMatch));
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        activeCategory = tab.getAttribute('data-category');
        filterRows();
      });
    });

    search.addEventListener('input', filterRows);
  })();
</script>
