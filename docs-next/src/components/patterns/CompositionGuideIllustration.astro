---
import { compositionGuideSvgs } from './composition-guide-svgs';

interface Props {
  name: string;
}

const { name } = Astro.props;
const svg = compositionGuideSvgs[name];
---

{svg && (
  <div class="guide-illustration" set:html={svg} />
)}

<style>
  .guide-illustration {
    flex-shrink: 0;
    width: 200px;
    height: 180px;
  }

  .guide-illustration :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
