{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@2.1.2"],
      "env": {},
      "disabled": false
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@0.18.1"],
      "env": {},
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.68"],
      "env": {},
      "disabled": false
    },
    "semgrep": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/semgrep-mcp@0.1.0"],
      "env": {},
      "disabled": true
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.38", "https://mcp.sentry.dev/mcp"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}"
      },
      "disabled": true
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "supabase-mcp-server@0.3.0"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      },
      "disabled": true
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp@0.3.1"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      },
      "disabled": true
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.38", "https://mcp.vercel.com"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      },
      "disabled": true
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.38", "https://mcp.figma.com/mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      },
      "disabled": true
    }
  }
}
