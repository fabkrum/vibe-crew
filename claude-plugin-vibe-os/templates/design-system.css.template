/* ================================================================
   {{PROJECT_NAME}} — Design System
   Generated by VibeOS Builder Agent
   ================================================================ */

:root {
  /* ---- Colors: HSL for easy manipulation ---- */

  /* Primary */
  --color-primary-h: {{PRIMARY_HUE}};
  --color-primary-s: 85%;
  --color-primary-l: 55%;
  --color-primary: hsl(var(--color-primary-h), var(--color-primary-s), var(--color-primary-l));
  --color-primary-foreground: hsl(0, 0%, 100%);
  --color-primary-hover: hsl(var(--color-primary-h), var(--color-primary-s), 48%);
  --color-primary-active: hsl(var(--color-primary-h), var(--color-primary-s), 42%);

  /* Secondary */
  --color-secondary-h: calc(var(--color-primary-h) + 30);
  --color-secondary-s: 60%;
  --color-secondary-l: 55%;
  --color-secondary: hsl(var(--color-secondary-h), var(--color-secondary-s), var(--color-secondary-l));
  --color-secondary-foreground: hsl(0, 0%, 100%);

  /* Neutral */
  --color-background: hsl(0, 0%, 100%);
  --color-foreground: hsl(0, 0%, 9%);
  --color-muted: hsl(0, 0%, 96%);
  --color-muted-foreground: hsl(0, 0%, 45%);
  --color-border: hsl(0, 0%, 90%);
  --color-input: hsl(0, 0%, 90%);
  --color-ring: var(--color-primary);

  /* Semantic */
  --color-success: hsl(142, 71%, 45%);
  --color-success-foreground: hsl(0, 0%, 100%);
  --color-warning: hsl(38, 92%, 50%);
  --color-warning-foreground: hsl(0, 0%, 9%);
  --color-error: hsl(0, 84%, 60%);
  --color-error-foreground: hsl(0, 0%, 100%);
  --color-info: hsl(217, 91%, 60%);
  --color-info-foreground: hsl(0, 0%, 100%);

  /* Card / Popover */
  --color-card: hsl(0, 0%, 100%);
  --color-card-foreground: hsl(0, 0%, 9%);
  --color-popover: hsl(0, 0%, 100%);
  --color-popover-foreground: hsl(0, 0%, 9%);

  /* ---- Typography: Modular Scale (1.25 ratio) ---- */
  --font-family-sans: {{FONT_FAMILY}}, ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-family-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  --font-size-xs: 0.64rem;
  --font-size-sm: 0.8rem;
  --font-size-base: 1rem;
  --font-size-lg: 1.25rem;
  --font-size-xl: 1.563rem;
  --font-size-2xl: 1.953rem;
  --font-size-3xl: 2.441rem;
  --font-size-4xl: 3.052rem;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --line-height-tight: 1.25;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.75;
  --letter-spacing-tight: -0.025em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide: 0.025em;

  /* ---- Spacing: 4px base unit ---- */
  --spacing-0: 0;
  --spacing-1: 0.25rem;
  --spacing-2: 0.5rem;
  --spacing-3: 0.75rem;
  --spacing-4: 1rem;
  --spacing-5: 1.25rem;
  --spacing-6: 1.5rem;
  --spacing-8: 2rem;
  --spacing-10: 2.5rem;
  --spacing-12: 3rem;
  --spacing-16: 4rem;
  --spacing-20: 5rem;
  --spacing-24: 6rem;

  /* ---- Border Radius ---- */
  --radius-none: 0;
  --radius-sm: calc({{BORDER_RADIUS}} * 0.5);
  --radius-md: {{BORDER_RADIUS}};
  --radius-lg: calc({{BORDER_RADIUS}} * 1.5);
  --radius-xl: calc({{BORDER_RADIUS}} * 2);
  --radius-full: 9999px;

  /* ---- Shadows ---- */
  --shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);

  /* ---- Breakpoints (reference only — use in @media) ---- */
  --breakpoint-sm: 640px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px;
  --breakpoint-2xl: 1536px;

  /* ---- Transitions ---- */
  --transition-fast: 150ms ease;
  --transition-normal: 250ms ease;
  --transition-slow: 350ms ease;

  /* ---- Z-Index Scale ---- */
  --z-dropdown: 50;
  --z-sticky: 100;
  --z-fixed: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-popover: 500;
  --z-toast: 600;
}

/* ---- Dark Mode ---- */
@media (prefers-color-scheme: dark) {
  :root {
    --color-background: hsl(0, 0%, 9%);
    --color-foreground: hsl(0, 0%, 95%);
    --color-muted: hsl(0, 0%, 15%);
    --color-muted-foreground: hsl(0, 0%, 64%);
    --color-border: hsl(0, 0%, 20%);
    --color-input: hsl(0, 0%, 20%);
    --color-card: hsl(0, 0%, 12%);
    --color-card-foreground: hsl(0, 0%, 95%);
    --color-popover: hsl(0, 0%, 12%);
    --color-popover-foreground: hsl(0, 0%, 95%);
    --color-primary-l: 60%;
    --color-primary-hover: hsl(var(--color-primary-h), var(--color-primary-s), 65%);
    --color-primary-active: hsl(var(--color-primary-h), var(--color-primary-s), 70%);
  }
}
