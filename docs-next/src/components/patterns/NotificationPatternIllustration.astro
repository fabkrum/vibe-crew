---
import { notificationPatternSvgs } from './notification-pattern-svgs';

interface Props {
  name: string;
}

const { name } = Astro.props;
const svg = notificationPatternSvgs[name];
---

{svg && (
  <div class="pattern-illustration" set:html={svg} />
)}

<style>
  .pattern-illustration {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
  }

  .pattern-illustration :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
