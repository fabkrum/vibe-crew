---
// Import SVG maps (input moved to FormPatternIllustration)
import { dataSvgs } from './data-svgs';
import { navigationSvgs } from './navigation-svgs';
import { feedbackSvgs } from './feedback-svgs';
import { overlaySvgs } from './overlay-svgs';
import { layoutSvgs } from './layout-svgs';
import { interactionSvgs } from './interaction-svgs';
import { keyboardSvgs } from './keyboard-svgs';
import { responsiveSvgs } from './responsive-svgs';
import { errorSvgs } from './error-svgs';

interface Props {
  name: string;
}

const { name } = Astro.props;

// Merge all maps — later maps win on key collision (shouldn't happen)
const allSvgs: Record<string, string> = {
  ...dataSvgs,
  ...navigationSvgs,
  ...feedbackSvgs,
  ...overlaySvgs,
  ...layoutSvgs,
  ...interactionSvgs,
  ...keyboardSvgs,
  ...responsiveSvgs,
  ...errorSvgs,
};

const svg = allSvgs[name];
---

{svg && (
  <div class="pattern-illustration" set:html={svg} />
)}

<style>
  .pattern-illustration {
    flex-shrink: 0;
    width: 200px;
    height: 120px;
  }

  .pattern-illustration :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
