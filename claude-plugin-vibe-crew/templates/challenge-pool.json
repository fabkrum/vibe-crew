{
  "schema_version": "1.0.0",
  "daily_challenges": [
    {
      "id": "daily-clean-sweep",
      "name": "Clean Sweep",
      "description": "Complete a session with 0 deductions",
      "type": "daily",
      "xp_reward": 20,
      "target_skill": "workflow_discipline",
      "condition": {
        "metric": "session_deductions",
        "comparator": "equals",
        "value": 0
      }
    },
    {
      "id": "daily-cache-champion",
      "name": "Cache Champion",
      "description": "Achieve >70% cache utilization in a session",
      "type": "daily",
      "xp_reward": 20,
      "target_skill": "context_management",
      "condition": {
        "metric": "cache_ratio",
        "comparator": "greater_than",
        "value": 0.70
      }
    },
    {
      "id": "daily-no-churn",
      "name": "Clear Channel",
      "description": "Complete a session with 0 prompt churn sequences",
      "type": "daily",
      "xp_reward": 20,
      "target_skill": "prompting",
      "condition": {
        "metric": "prompt_churn_sequences",
        "comparator": "equals",
        "value": 0
      }
    },
    {
      "id": "daily-context-light",
      "name": "Light Footprint",
      "description": "Keep context usage under 40% for the entire session",
      "type": "daily",
      "xp_reward": 25,
      "target_skill": "context_management",
      "condition": {
        "metric": "peak_context_pct",
        "comparator": "less_than",
        "value": 40
      }
    },
    {
      "id": "daily-test-pass",
      "name": "Green Light",
      "description": "All tests pass on the first run",
      "type": "daily",
      "xp_reward": 20,
      "target_skill": "testing",
      "condition": {
        "metric": "tests_first_pass",
        "comparator": "equals",
        "value": true
      }
    },
    {
      "id": "daily-phase-complete",
      "name": "Phase Finisher",
      "description": "Complete at least one Tier 2 phase",
      "type": "daily",
      "xp_reward": 15,
      "target_skill": "workflow_discipline",
      "condition": {
        "metric": "phases_completed_this_session",
        "comparator": "greater_than",
        "value": 0
      }
    }
  ],
  "weekly_challenges": [
