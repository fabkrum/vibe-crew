/**
 * Assert that a rendered container has no axe-core accessibility violations.
 *
 * @example
 * ```ts
 * const { container } = render(<MyComponent />);
 * await expectNoA11yViolations(container);
 * ```
 */
export async function expectNoA11yViolations(container: HTMLElement) {
  const results = await axe(container);
  expect(results).toHaveNoViolations();
}

// ---------------------------------------------------------------------------
// Wait utilities
// ---------------------------------------------------------------------------

/**
 * Waits until no loading spinners (elements with role="status" or
 * `aria-busy="true"`) remain in the document.
 */
export async function waitForLoadingToFinish() {
  await waitFor(() => {
    const loaders = [
      ...screen.queryAllByRole('status'),
      ...document.querySelectorAll('[aria-busy="true"]'),
    ];
    loaders.forEach((loader) => {
      expect(loader).not.toBeInTheDocument();
    });
  });
}
