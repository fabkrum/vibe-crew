---
interface Props {
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
---

<div class="mermaid-container">
  <pre class="mermaid" set:html={chart}></pre>
  {caption && <p class="mermaid-caption">{caption}</p>}
  <noscript>
    <pre><code>{chart}</code></pre>
  </noscript>
</div>

<style>
  .mermaid-container {
    margin-bottom: 2rem;
    /* Break out of the narrow content column for more diagram space */
    margin-left: -8vw;
    margin-right: -8vw;
    padding: 1.5rem 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }
  pre.mermaid {
    background: transparent;
    border: none;
    padding: 0;
    text-align: center;
    min-width: min-content;
  }
  /* Ensure rendered SVGs scale up to fill width */
  .mermaid-container :global(svg) {
    max-width: 100%;
    height: auto;
    min-height: 300px;
  }
  .mermaid-caption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
  }
  @media (max-width: 768px) {
    .mermaid-container {
      margin-left: -1rem;
      margin-right: -1rem;
      padding: 1rem;
      border-radius: 0;
    }
  }
</style>

<script is:inline>
  (function() {
    if (document.querySelector('.mermaid') && !window.__mermaidLoaded) {
      window.__mermaidLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      s.onload = function() {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          fontSize: 16,
          flowchart: {
            padding: 24,
            nodeSpacing: 40,
            rankSpacing: 50,
            useMaxWidth: true,
          },
          themeVariables: {
            primaryColor: '#7c3aed',
            primaryTextColor: '#fafafa',
            primaryBorderColor: '#a78bfa',
            lineColor: '#a78bfa',
            secondaryColor: '#18181b',
            tertiaryColor: '#111113',
            background: '#0a0a0b',
            mainBkg: '#18181b',
            nodeBorder: '#a78bfa',
            clusterBkg: '#111113',
            clusterBorder: '#27272a',
            titleColor: '#fafafa',
            edgeLabelBackground: '#18181b',
            fontSize: '16px',
          },
        });
        // Only render visible diagrams; hidden ones are rendered on demand
        var visible = document.querySelectorAll('.arch-panel.active pre.mermaid');
        if (visible.length > 0) {
          mermaid.run({ nodes: visible });
        } else {
          // Fallback: render all visible .mermaid elements (non-tabbed pages)
          var all = document.querySelectorAll('pre.mermaid');
          if (all.length > 0) {
            mermaid.run({ nodes: all });
          }
        }
      };
      document.head.appendChild(s);
    }
  })();
</script>
