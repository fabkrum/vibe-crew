---
import DocsLayout from '../layouts/DocsLayout.astro';
import AnimationPatternIllustration from '../components/patterns/AnimationPatternIllustration.astro';
import { animationPatterns, categoryLabels, categoryOrder } from '../data/animation-patterns';
import type { AnimationPattern } from '../data/animation-patterns';

// Group patterns by category
const grouped = categoryOrder.reduce((acc, cat) => {
  const items = animationPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof animationPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<AnimationPattern['category'], string> = {
  foundations: 'Core principles that apply to every animation — reduced motion compliance, GPU-safe properties, and duration/easing token selection.',
  'entrance-exit': 'Patterns for showing and hiding content — fades, slides, scales, and height-safe collapse animations.',
  micro: 'Subtle feedback animations that make interfaces feel alive — hover, press, toggle, and validation effects.',
  loading: 'Visual indicators for asynchronous operations — skeleton loading, spinners, progress bars, and content transitions.',
  scroll: 'Animations triggered by scroll position — reveal effects, parallax, progress indicators, and staggered lists.',
  overlay: 'Motion patterns for floating UI — toasts, modals, tooltips, and drawer/sheet transitions.',
};
---

<DocsLayout title="Animation Patterns" sectionLabel="Reference" activeSlug="animation-patterns">

  <h2>Animation & Motion Patterns</h2>
  <p>Design-system-aware animation patterns that VibeCrew agents apply during design and code review. Every pattern uses design tokens, respects <code>prefers-reduced-motion</code>, and only animates GPU-composited properties.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()]/g, '-')}>
            <div class="pattern-card-inner">
              <AnimationPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Reduced Motion</span>
                    <p>{entry.reducedMotion}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs →</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Add a loading animation"</td><td>Shimmer/Skeleton Loading (gradient sweep, aria-busy)</td></tr>
        <tr><td>"Make it feel snappy"</td><td>Hover Feedback (scale 1.02) + Press Feedback (scale 0.97)</td></tr>
        <tr><td>"Fade things in on scroll"</td><td>Scroll Reveal (IntersectionObserver + fade/slide)</td></tr>
        <tr><td>"Animate the modal"</td><td>Backdrop fade + content scale with ease-out enter</td></tr>
        <tr><td>"Add a notification animation"</td><td>Toast slide-in with auto-dismiss</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Pages</h3>
    <ul class="related-links">
      <li><a href="/ui-patterns#cat-interaction">UI Patterns: Interaction & Performance</a> &mdash; Loading states, skeleton patterns, and page transitions</li>
      <li><a href="/ui-patterns#cat-responsive">UI Patterns: Responsive Design</a> &mdash; Touch targets and responsive navigation</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://web.dev/articles/animations-guide" target="_blank" rel="noopener noreferrer">web.dev Animation Guide</a> &mdash; Performance-focused animation best practices</li>
      <li><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/@media/prefers-reduced-motion" target="_blank" rel="noopener noreferrer">MDN prefers-reduced-motion</a> &mdash; Accessibility reference for motion preferences</li>
      <li><a href="https://animate.style/" target="_blank" rel="noopener noreferrer">Animate.css</a> &mdash; Premade animation library for reference and inspiration</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .category-nav a {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .category-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .category-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    margin-top: 2rem;
  }

  .category-description {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .pattern-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .pattern-card {
    padding: 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .pattern-card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .pattern-content {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .pattern-card-inner {
      flex-direction: column;
    }
  }

  .pattern-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .pattern-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .pattern-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-block {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-block p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .meta-label {
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-right: 0.35rem;
  }

  .docs-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .docs-link:hover {
    text-decoration: underline;
  }

  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }

  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }

  .further-reading {
    margin-top: 3rem;
  }

  .further-reading ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .further-reading li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .further-reading li:last-child {
    border-bottom: none;
  }

  .further-reading a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .further-reading a:hover {
    text-decoration: underline;
  }
</style>
