---
import DocsLayout from '../layouts/DocsLayout.astro';
import Callout from '../components/Callout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const bootstrapCmd = `curl -fsSL https://raw.githubusercontent.com/anthropics/vibe-crew/main/bootstrap.sh | bash`;

const manualInstall = `git clone https://github.com/anthropics/vibe-crew.git
cd vibe-crew/claude-plugin-vibe-crew
bash install.sh`;

const launchCmd = `claude --plugin-dir /path/to/claude-plugin-vibe-crew`;

const checkDepsOutput = `{
  "dependencies": [
    { "name": "Git",  "status": "ok", "found": "2.43.0", "required": "2.30.0", "level": "required" },
    { "name": "Node", "status": "ok", "found": "20.11.0", "required": "18.0.0", "level": "required" },
    { "name": "jq",   "status": "ok", "found": "1.7.1", "required": "1.6",   "level": "required" }
  ],
  "summary": { "passed": 3, "required_failed": 0, "optional_missing": 1, "ready": true }
}`;

const configSnippet = `{
  "schema_version": "1.6.0",
  "terminal": "warp",
  "claude_command": "claude",
  "notifications": {
    "enabled": true,
    "sound": "Submarine",
    "on_permission_prompt": true,
    "on_task_complete": true,
    "on_failure": true
  },
  "mcp_servers": {
    "context7": true,
    "chrome_devtools": true,
    "playwright": true
  },
  "cost_limits": {
    "session_warn": 2,
    "session_max": 5,
    "daily_warn": 20
  },
  "user_profile": {
    "interview_completed": false
  }
}`;
---

<DocsLayout title="Setup in Detail" sectionLabel="How It Works" activeSlug="setup-detail">

