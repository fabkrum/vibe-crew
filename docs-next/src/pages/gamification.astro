---
import DocsLayout from '../layouts/DocsLayout.astro';
import Callout from '../components/Callout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import TableWrap from '../components/TableWrap.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';

const configFull = `"gamification": {
  "enabled": true,
  "streak_reminders": true,
  "quiz_frequency": "weekly",
  "show_xp_in_status": true
}`;

const configDisabled = `"gamification": {
  "enabled": false,
  "streak_reminders": false,
  "quiz_frequency": "weekly",
  "show_xp_in_status": false
}`;

const profileGamification = `"user_profile": {
  "gamification_preference": "full"
  // Options: "full" | "light" | "score_only" | "disabled"
}`;
---

<DocsLayout title="Gamification" sectionLabel="How It Works" activeSlug="gamification">

  <div class="toc">
    <h3>On This Page</h3>
    <ol>
      <li><a href="#overview">Overview</a></li>
      <li><a href="#enable-disable">Enabling &amp; Disabling</a></li>
      <li><a href="#vibe-score">Vibe Score</a></li>
