---
import DocsLayout from '../layouts/DocsLayout.astro';
import SettingsPatternIllustration from '../components/patterns/SettingsPatternIllustration.astro';
import { settingsPatterns, categoryLabels, categoryOrder } from '../data/settings-patterns';
import type { SettingsPattern } from '../data/settings-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = settingsPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof settingsPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<SettingsPattern['category'], string> = {
  layout: 'Layout patterns -- sidebar navigation, tabbed views, grouped sections, two-column rows, and search for organizing settings pages at any scale.',
  account: 'Account management patterns -- profile editing, avatar uploads, account deletion, connected OAuth accounts, and username/handle changes.',
  preferences: 'Preference patterns -- theme selectors, notification matrices, language/locale, keyboard shortcuts, and auto-save behaviors for user customization.',
  billing: 'Billing patterns -- plan selectors, payment method management, billing history, usage meters, and plan comparison tables for subscription management.',
  security: 'Security patterns -- password changes, two-factor authentication setup, active sessions, API key management, and security event logs.',
  data: 'Data patterns -- data export, privacy controls, cookie consent management, selective data deletion, and import/migration tools for data portability.',
};
---

<DocsLayout title="Settings Patterns" sectionLabel="Reference" activeSlug="settings-patterns">

  <h2>Settings & Preferences Patterns</h2>
  <p>Research-backed patterns for settings pages, account management, and user preferences that VibeCrew agents apply when building configuration interfaces, billing flows, security settings, and privacy controls. Each pattern includes implementation guidance, accessibility requirements, and anti-patterns based on Material Design, Apple HIG, NN/G, Baymard, WCAG, GDPR, and leading SaaS products (Stripe, GitHub, Vercel, Linear).</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+@]/g, '-')}>
            <div class="pattern-card-inner">
              <SettingsPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Add a settings page"</td><td>Sidebar Settings Navigation + Grouped Settings Sections + Two-Column Setting Rows + Auto-Save Settings with per-toggle feedback</td></tr>
        <tr><td>"Add user profiles"</td><td>Profile Editor with form validation + Avatar Upload with crop modal + Username &amp; Handle with real-time uniqueness check + Connected Accounts (OAuth)</td></tr>
        <tr><td>"Add billing"</td><td>Subscription Plan Selector (monthly/annual toggle) + Payment Method Management (Stripe Elements) + Billing History table + Usage Meters for plan limits</td></tr>
        <tr><td>"Add security settings"</td><td>Password Change with strength meter + Two-Factor Authentication Setup (QR + recovery codes) + Active Sessions with remote revoke + Security Log</td></tr>
        <tr><td>"Make it GDPR compliant"</td><td>Data Export (Article 20) + Privacy Controls with granular toggles + Cookie Consent Manager + Account Data Deletion (Article 17) with grace period</td></tr>
        <tr><td>"Add dark mode"</td><td>Theme Selector (Light/Dark/System) with prefers-color-scheme auto-detection, localStorage for FOUC prevention, and WCAG-compliant contrast in both themes</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement settings interfaces. They are referenced here rather than duplicated -- click through for full details.</p>
    <ul class="related-links">
      <li><a href="/form-patterns#toggle-switch">Toggle Switch</a> &mdash; On/off toggle for boolean settings (Form Patterns)</li>
      <li><a href="/form-patterns#select-dropdown">Select Dropdown</a> &mdash; Single-selection control for settings with multiple options (Form Patterns)</li>
      <li><a href="/ui-patterns#accordion">Accordion</a> &mdash; Expandable sections for organizing grouped settings (UI Patterns)</li>
      <li><a href="/ui-patterns#tabs">Tabs</a> &mdash; Horizontal tab navigation for settings categories (UI Patterns)</li>
      <li><a href="/notification-patterns#toast-notification">Toast Notification</a> &mdash; Transient feedback for settings save confirmations (Notification Patterns)</li>
      <li><a href="/auth-patterns#session-management">Session Management</a> &mdash; Session handling for active sessions display (Authentication Patterns)</li>
      <li><a href="/auth-patterns#multi-factor-authentication">Multi-Factor Authentication</a> &mdash; MFA enrollment patterns for security settings (Authentication Patterns)</li>
      <li><a href="/legal-compliance#gdpr-compliance">GDPR Compliance</a> &mdash; Data protection requirements for privacy controls (Legal &amp; Compliance)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://m1.material.io/patterns/settings.html" target="_blank" rel="noopener noreferrer">Material Design: Settings</a> &mdash; Android settings pattern guidelines (layout, controls, defaults)</li>
      <li><a href="https://www.nngroup.com/articles/ten-usability-heuristics/" target="_blank" rel="noopener noreferrer">NN/G: 10 Usability Heuristics</a> &mdash; Core UX principles applied to settings design (user control, error prevention, consistency)</li>
      <li><a href="https://baymard.com/research/self-service" target="_blank" rel="noopener noreferrer">Baymard: Accounts &amp; Self-Service UX</a> &mdash; Research on account settings, profile management, and self-service flows</li>
      <li><a href="https://docs.stripe.com/payments/elements" target="_blank" rel="noopener noreferrer">Stripe Elements</a> &mdash; PCI-compliant payment form components for billing settings</li>
      <li><a href="https://www.smashingmagazine.com/2025/04/inclusive-dark-mode-designing-accessible-dark-themes/" target="_blank" rel="noopener noreferrer">Smashing Magazine: Inclusive Dark Mode</a> &mdash; Designing accessible dark themes with proper contrast and prefers-color-scheme</li>
      <li><a href="https://gdpr-info.eu/art-17-gdpr/" target="_blank" rel="noopener noreferrer">GDPR Article 17: Right to Erasure</a> &mdash; Legal requirements for data deletion settings</li>
      <li><a href="https://developer.android.com/design/ui/mobile/guides/patterns/settings" target="_blank" rel="noopener noreferrer">Android Developers: Settings</a> &mdash; Platform-specific settings pattern guidance</li>
      <li><a href="https://www.w3.org/WAI/ARIA/apg/patterns/" target="_blank" rel="noopener noreferrer">W3C WAI ARIA Patterns</a> &mdash; Accessibility patterns for switches, tabs, dialogs, and form controls used in settings</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
