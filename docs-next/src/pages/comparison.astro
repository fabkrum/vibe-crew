---
import DocsLayout from '../layouts/DocsLayout.astro';
import Callout from '../components/Callout.astro';
import TableWrap from '../components/TableWrap.astro';
import { url } from '../data/site';

const threeLayers = `<svg viewBox="0 0 300 180" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Outer ring: Development Lifecycle -->
  <rect x="10" y="10" width="280" height="160" rx="16" style="stroke: var(--color-accent); fill: var(--color-accent-bg)" stroke-width="2"/>
  <text x="150" y="30" text-anchor="middle" style="fill: var(--color-accent); font-size: 9px; font-weight: 700; font-family: var(--font-sans)">Development Lifecycle</text>
  <text x="274" y="168" text-anchor="end" style="fill: var(--color-accent); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">VibeCrew</text>

  <!-- Middle ring: Quality & Review -->
  <rect x="40" y="38" width="220" height="112" rx="12" style="stroke: var(--color-blue); fill: var(--color-blue-dim)" stroke-width="1.5"/>
  <text x="150" y="54" text-anchor="middle" style="fill: var(--color-blue); font-size: 9px; font-weight: 700; font-family: var(--font-sans)">Quality &amp; Review</text>
  <text x="244" y="142" text-anchor="end" style="fill: var(--color-blue); font-size: 7px; font-family: var(--font-sans)">Some tools attempt</text>

  <!-- Inner ring: Code Generation -->
  <rect x="70" y="62" width="160" height="72" rx="10" style="stroke: var(--color-green); fill: var(--color-green-dim)" stroke-width="1.5"/>
  <text x="150" y="78" text-anchor="middle" style="fill: var(--color-green); font-size: 9px; font-weight: 700; font-family: var(--font-sans)">Code Generation</text>
  <text x="216" y="126" text-anchor="end" style="fill: var(--color-green); font-size: 7px; font-family: var(--font-sans)">All tools do this</text>

  <!-- Tool labels positioned in rings -->
  <rect x="86" y="88" width="56" height="16" rx="4" style="fill: var(--color-surface); stroke: var(--color-border)" stroke-width="1"/>
  <text x="114" y="99" text-anchor="middle" style="fill: var(--color-text-secondary); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Cursor</text>
  <rect x="152" y="88" width="62" height="16" rx="4" style="fill: var(--color-surface); stroke: var(--color-border)" stroke-width="1"/>
  <text x="183" y="99" text-anchor="middle" style="fill: var(--color-text-secondary); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Windsurf</text>
  <rect x="100" y="108" width="68" height="16" rx="4" style="fill: var(--color-surface); stroke: var(--color-blue)" stroke-width="1"/>
  <text x="134" y="119" text-anchor="middle" style="fill: var(--color-blue); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Antigravity</text>
</svg>`;

const workflowComparison = `<svg viewBox="0 0 360 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Top lane: Without VibeCrew -->
  <text x="4" y="12" style="fill: var(--color-text-muted); font-size: 8px; font-weight: 600; font-family: var(--font-sans)">Without VibeCrew</text>
  <rect x="4" y="18" width="52" height="24" rx="4" style="fill: var(--color-surface-2); stroke: var(--color-border)" stroke-width="1"/>
  <text x="30" y="34" text-anchor="middle" style="fill: var(--color-text-secondary); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Prompt</text>
  <line x1="58" y1="30" x2="68" y2="30" style="stroke: var(--color-border)" stroke-width="1"/>
  <rect x="70" y="18" width="48" height="24" rx="4" style="fill: var(--color-surface-2); stroke: var(--color-border)" stroke-width="1"/>
  <text x="94" y="34" text-anchor="middle" style="fill: var(--color-text-secondary); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Code</text>
  <line x1="120" y1="30" x2="130" y2="30" style="stroke: var(--color-border)" stroke-width="1"/>
  <rect x="132" y="18" width="60" height="24" rx="4" style="fill: var(--color-amber-dim); stroke: var(--color-amber)" stroke-width="1"/>
  <text x="162" y="34" text-anchor="middle" style="fill: var(--color-amber); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Hope it works</text>
  <line x1="194" y1="30" x2="204" y2="30" style="stroke: var(--color-border)" stroke-width="1"/>
  <rect x="206" y="18" width="52" height="24" rx="4" style="fill: var(--color-red-dim); stroke: var(--color-red)" stroke-width="1"/>
  <text x="232" y="34" text-anchor="middle" style="fill: var(--color-red); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Fix bugs</text>
  <line x1="260" y1="30" x2="270" y2="30" style="stroke: var(--color-border)" stroke-width="1"/>
  <rect x="272" y="18" width="52" height="24" rx="4" style="fill: var(--color-red-dim); stroke: var(--color-red)" stroke-width="1"/>
  <text x="298" y="34" text-anchor="middle" style="fill: var(--color-red); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Repeat...</text>

  <!-- Bottom lane: With VibeCrew -->
  <text x="4" y="72" style="fill: var(--color-accent); font-size: 8px; font-weight: 700; font-family: var(--font-sans)">With VibeCrew</text>
  <rect x="4" y="78" width="52" height="24" rx="4" style="fill: var(--color-accent-bg); stroke: var(--color-accent)" stroke-width="1.5"/>
  <text x="30" y="94" text-anchor="middle" style="fill: var(--color-accent); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Plan</text>
  <line x1="58" y1="90" x2="68" y2="90" style="stroke: var(--color-accent)" stroke-width="1"/>
  <rect x="70" y="78" width="52" height="24" rx="4" style="fill: var(--color-accent-bg); stroke: var(--color-accent)" stroke-width="1.5"/>
  <text x="96" y="94" text-anchor="middle" style="fill: var(--color-accent); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Build</text>
  <line x1="124" y1="90" x2="134" y2="90" style="stroke: var(--color-accent)" stroke-width="1"/>
  <rect x="136" y="78" width="56" height="24" rx="4" style="fill: var(--color-green-dim); stroke: var(--color-green)" stroke-width="1.5"/>
  <text x="164" y="94" text-anchor="middle" style="fill: var(--color-green); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Auto-test</text>
  <polyline points="182,86 185,90 192,82" style="stroke: var(--color-green); fill: none" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="194" y1="90" x2="204" y2="90" style="stroke: var(--color-accent)" stroke-width="1"/>
  <rect x="206" y="78" width="62" height="24" rx="4" style="fill: var(--color-green-dim); stroke: var(--color-green)" stroke-width="1.5"/>
  <text x="237" y="94" text-anchor="middle" style="fill: var(--color-green); font-size: 7px; font-weight: 600; font-family: var(--font-sans)">Auto-review</text>
  <polyline points="254,86 257,90 264,82" style="stroke: var(--color-green); fill: none" stroke-width="1.5" stroke-linecap="round"/>
  <line x1="270" y1="90" x2="280" y2="90" style="stroke: var(--color-accent)" stroke-width="1"/>
  <rect x="282" y="78" width="52" height="24" rx="4" style="fill: var(--color-green-dim); stroke: var(--color-green)" stroke-width="1.5"/>
  <text x="308" y="94" text-anchor="middle" style="fill: var(--color-green); font-size: 7px; font-weight: 700; font-family: var(--font-sans)">Ship</text>
  <polyline points="318,86 321,90 328,82" style="stroke: var(--color-green); fill: none" stroke-width="1.5" stroke-linecap="round"/>
</svg>`;
---

<DocsLayout title="Comparison" sectionLabel="Intro" activeSlug="comparison">

  <h2>VibeCrew vs. Alternatives</h2>
  <p>Most AI coding tools help you write code faster. VibeCrew helps you <strong>build products better</strong>. The difference: architecture before code, automated quality gates, and agents that know what production-quality means.</p>

  <!-- ── "Different category" callout ──────────────────────────── -->
  <Callout type="info" title="A different category">
    <p>VibeCrew enhances Claude Code with a structured development lifecycle. It&rsquo;s complementary to Cursor (inline completions) and Google Antigravity (general-purpose agents). They generate code. VibeCrew ensures code is production-ready.</p>
  </Callout>

  <!-- ── Three-layers SVG ──────────────────────────────────────── -->
  <div class="layers-svg" set:html={threeLayers} />

  <!-- ── Comparison Table ──────────────────────────────────────── -->
  <section class="section">
    <h3>Feature Comparison</h3>

    <TableWrap>
      <table>
        <thead>
          <tr>
            <th>Capability</th>
            <th>VibeCrew</th>
            <th>Claude Code (vanilla)</th>
            <th>Cursor / Windsurf</th>
            <th>Google Antigravity</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Architecture-first workflow</strong></td>
            <td>Enforced via phase gate</td>
            <td>Manual discipline</td>
            <td>Not enforced</td>
            <td>Not enforced</td>
          </tr>
          <tr>
            <td><strong>Multi-agent orchestration</strong></td>
            <td>14 specialized agents</td>
            <td>Single agent</td>
            <td>Single agent</td>
            <td>Multi-agent</td>
          </tr>
          <tr>
            <td><strong>Quality enforcement</strong></td>
            <td>Hooks run tests/lint/build automatically</td>
            <td>Manual</td>
            <td>Limited</td>
            <td>Basic checks</td>
          </tr>
          <tr>
            <td><strong>Token efficiency</strong></td>
            <td>Worktree isolation, MCP servers, context compaction</td>
            <td>Manual context management</td>
            <td>IDE-integrated context</td>
            <td>Cloud-managed context</td>
          </tr>
          <tr>
            <td><strong>Design system</strong></td>
            <td>Generated via Design Discovery interview</td>
            <td>Manual creation</td>
            <td>Not included</td>
            <td>Not included</td>
          </tr>
          <tr>
            <td><strong>UI &amp; business patterns</strong></td>
            <td>Built-in pattern libraries</td>
            <td>Not included</td>
            <td>Not included</td>
            <td>Not included</td>
          </tr>
          <tr>
            <td><strong>Cost tracking</strong></td>
            <td>Real-time dashboard, session/daily guardrails</td>
            <td>API billing only</td>
            <td>Subscription-based</td>
            <td>Usage-based billing</td>
          </tr>
          <tr>
            <td><strong>Session continuity</strong></td>
            <td>Handoffs, state files, session logs</td>
            <td>/compact only</td>
            <td>IDE state</td>
            <td>Cloud sessions</td>
          </tr>
          <tr>
            <td><strong>Autonomous mode</strong></td>
            <td>/run-backlog auto-executes features</td>
            <td>Manual per-task</td>
            <td>Manual per-task</td>
            <td>Agent-driven tasks</td>
          </tr>
          <tr>
            <td><strong>Code review</strong></td>
            <td>Dedicated Code Reviewer agent</td>
            <td>Manual prompt</td>
            <td>Not built-in</td>
            <td>Not built-in</td>
          </tr>
          <tr>
            <td><strong>Security auditing</strong></td>
            <td>OWASP Top 10 via Security Auditor</td>
            <td>Manual prompt</td>
            <td>Not built-in</td>
            <td>Not built-in</td>
          </tr>
          <tr>
            <td><strong>Documentation</strong></td>
            <td>Auto-generated, drift detection</td>
            <td>Manual</td>
            <td>Not built-in</td>
            <td>Not built-in</td>
          </tr>
          <tr>
            <td><strong>Non-technical users</strong></td>
            <td>Founder profile preset, adaptive verbosity</td>
            <td>Requires prompting skill</td>
            <td>Requires coding knowledge</td>
            <td>Natural language prompting</td>
          </tr>
          <tr>
            <td><strong>Model support</strong></td>
            <td>Claude (Opus, Sonnet, Haiku)</td>
            <td>Claude</td>
            <td>Multiple (GPT, Claude, etc.)</td>
            <td>Gemini</td>
          </tr>
          <tr>
            <td><strong>Platform</strong></td>
            <td>Terminal (any OS with Claude Code)</td>
            <td>Terminal</td>
            <td>Desktop IDE</td>
            <td>Browser-based</td>
          </tr>
          <tr>
            <td><strong>Pricing</strong></td>
            <td>Free (open source) + Claude Pro/Max or API</td>
            <td>Claude Pro/Max or API</td>
            <td>$20-40/month subscription</td>
            <td>$20-250/month</td>
          </tr>
        </tbody>
      </table>
    </TableWrap>
  </section>

  <!-- ── Workflow comparison SVG ────────────────────────────────── -->
  <div class="workflow-svg" set:html={workflowComparison} />

  <!-- ── When to Use ───────────────────────────────────────────── -->
  <section class="section">
    <h3>When to Use VibeCrew</h3>

    <div class="card-grid">
      <div class="card">
        <div class="card-icon green">&#10003;</div>
        <h4>Great fit</h4>
        <p>Building a new SaaS from scratch. Working on complex multi-feature projects. Non-technical founders building MVPs. Teams wanting consistent code quality across AI-generated code.</p>
      </div>
      <div class="card">
        <div class="card-icon amber">&#8776;</div>
        <h4>Okay fit</h4>
        <p>Quick scripts or one-off tools. Small bug fixes in existing codebases. Projects where you already have strong architecture and just need coding help.</p>
      </div>
      <div class="card">
        <div class="card-icon red">&#10007;</div>
        <h4>Not ideal</h4>
        <p>Inline code completion while typing (use Cursor/Copilot). Browser-based development (use Antigravity). Projects that don&rsquo;t use Git. Environments where Claude Code can&rsquo;t run.</p>
      </div>
    </div>
  </section>

  <!-- ── Better Together ───────────────────────────────────────── -->
  <section class="section">
    <h3>VibeCrew + Claude Code: Better Together</h3>
    <p>VibeCrew doesn't replace Claude Code &mdash; it enhances it. Everything you can do with vanilla Claude Code still works. VibeCrew adds:</p>
    <ul>
      <li><strong>Structure</strong> &mdash; A proven workflow instead of ad-hoc prompting</li>
      <li><strong>Enforcement</strong> &mdash; Hooks that catch mistakes before they ship</li>
      <li><strong>Specialization</strong> &mdash; 14 agents optimized for specific tasks</li>
      <li><strong>Memory</strong> &mdash; State files, session logs, and handoffs that survive across sessions</li>
      <li><strong>Visibility</strong> &mdash; Vibe Scores, cost tracking, and a visual dashboard</li>
      <li><strong>Pattern intelligence</strong> &mdash; Built-in UI and business patterns that guide agents toward production-quality output</li>
    </ul>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="section">
    <Callout type="tip" title="Ready to try it?">
      <p>Start with the Quick Start &mdash; you&rsquo;ll be building your first feature in minutes.</p>
    </Callout>
    <div class="comparison-cta">
      <a class="hero-btn primary" href={url('/quick-start.html')}>Get Started &rarr;</a>
      <a class="hero-btn secondary" href={url('/example-session.html')}>See an Example Session</a>
    </div>
  </section>

</DocsLayout>

<style>
  /* ── Three-layers SVG ────────────────────────────────────── */
  .layers-svg {
    max-width: 400px;
    margin: 1.5rem auto;
  }

  .layers-svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Workflow comparison SVG ──────────────────────────────── */
  .workflow-svg {
    max-width: 480px;
    margin: 1.5rem auto;
  }

  .workflow-svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── CTA buttons ─────────────────────────────────────────── */
  .comparison-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .hero-btn.primary {
    background: var(--color-accent);
    color: #fff;
  }

  .hero-btn.primary:hover {
    background: var(--color-accent-dim);
  }

  .hero-btn.secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .hero-btn.secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
