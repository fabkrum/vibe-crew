---
import DocsLayout from '../layouts/DocsLayout.astro';
import SocialPatternIllustration from '../components/patterns/SocialPatternIllustration.astro';
import { socialPatterns, categoryLabels, categoryOrder } from '../data/social-patterns';
import type { SocialPattern } from '../data/social-patterns';

const grouped = categoryOrder.reduce((acc, cat) => {
  const items = socialPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof socialPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<SocialPattern['category'], string> = {
  profile_links: 'Profile link patterns -- icon bars, branded cards, author attribution, floating sidebars, and bio cards for linking to social profiles without third-party scripts.',
  share: 'Share button patterns -- Web Share API, static share links, two-click Shariff consent, copy-link, email share, and preview cards for privacy-respecting content sharing.',
  embeds: 'Social embed patterns -- facade click-to-load, privacy-proxied iframes, blockquote fallbacks, consent walls, and server-rendered cards that block tracking until user consent.',
  feeds: 'Social feed patterns -- static build-time snapshots, RSS-powered feeds, hybrid refresh, and curated testimonial walls that display social content without client-side API calls.',
  social_proof: 'Social proof patterns -- static counter displays, GitHub star badges, testimonial carousels, and user count banners for building trust without real-time tracking widgets.',
  identity: 'Structured identity patterns -- rel="me" verification, Schema.org sameAs, Open Graph profile tags, and Webfinger for establishing machine-readable social identity.',
};
---

<DocsLayout title="Social Media Patterns" sectionLabel="Reference" activeSlug="social-patterns">

  <h2>Social Media Patterns</h2>
  <p>Privacy-respecting patterns for social media integration that VibeCrew agents apply when building social links, share buttons, embeds, feeds, and social proof. Every pattern follows a core principle: zero third-party scripts on page load, no data shared without explicit user action. Each pattern includes implementation guidance, accessibility requirements, and anti-patterns based on the IndieWeb movement, Heise/c't Shariff, GDPR requirements, Web Share API, Schema.org, and leading privacy-first implementations.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()&+@"=]/g, '-')}>
            <div class="pattern-card-inner">
              <SocialPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Implementation</span>
                    <p>{entry.implementation}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Accessibility</span>
                    <p>{entry.a11y}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs &rarr;</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="tips-section" id="tips">
    <h3 class="category-heading">Tips: What Users Say vs What Gets Built</h3>
    <table class="tips-table">
      <thead><tr><th>What you say</th><th>What gets built</th></tr></thead>
      <tbody>
        <tr><td>"Add social media links to the footer"</td><td>Icon Link Bar + rel="me" Verification + Schema.org sameAs (JSON-LD with all official social URLs)</td></tr>
        <tr><td>"Let users share blog posts"</td><td>Native Web Share API (primary) + Static Share Links (fallback) + Copy Link Button + Email Share Link</td></tr>
        <tr><td>"Embed our latest tweets on the homepage"</td><td>Facade Embed (Click-to-Load) with tweet screenshot placeholders + Consent-Gated Embed Wall for multiple embeds</td></tr>
        <tr><td>"Show our social media feed"</td><td>Static Feed Snapshot (build-time fetch) + RSS-Powered Feed for Mastodon/Bluesky + "Last updated" footer</td></tr>
        <tr><td>"Add social proof to the landing page"</td><td>Testimonial Carousel (curated data file) + User Count Banner + Static Counter Display (GitHub stars, downloads)</td></tr>
        <tr><td>"We need a team page with social links"</td><td>Bio Card with Social Links + Author Attribution Links + Schema.org Person with sameAs for each member</td></tr>
      </tbody>
    </table>
  </section>

  <section class="related-section" id="related">
    <h3 class="category-heading">Related Patterns</h3>
    <p class="category-description">These patterns on other pages complement social media integration. They are referenced here rather than duplicated -- click through for full details.</p>
    <ul class="related-links">
      <li><a href="/auth-patterns#social-login">Social Login</a> &mdash; OAuth social login flows for authentication (Authentication Patterns)</li>
      <li><a href="/notification-patterns#push-notification">Push Notification</a> &mdash; Browser push notifications as an alternative to social engagement (Notification Patterns)</li>
      <li><a href="/settings-patterns#connected-accounts">Connected Accounts</a> &mdash; Managing OAuth-linked social accounts in user settings (Settings Patterns)</li>
      <li><a href="/business-patterns#social-proof">Social Proof</a> &mdash; Business-level social proof strategies for conversion (Business Patterns)</li>
      <li><a href="/media-patterns#lazy-loading">Lazy Loading</a> &mdash; Lazy loading techniques used in embed facade placeholders (Media Patterns)</li>
      <li><a href="/legal-compliance#cookie-consent">Cookie Consent</a> &mdash; GDPR/ePrivacy requirements for social embed consent walls (Legal &amp; Compliance)</li>
      <li><a href="/media-patterns#image-optimization">Image Optimization</a> &mdash; Optimizing self-hosted social media images and avatars (Media Patterns)</li>
    </ul>
  </section>

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://github.com/heiseonline/shariff" target="_blank" rel="noopener noreferrer">Heise Shariff</a> &mdash; The original two-click privacy-respecting share button library from c't/Heise</li>
      <li><a href="https://indieweb.org/rel-me" target="_blank" rel="noopener noreferrer">IndieWeb: rel="me"</a> &mdash; Specification for bidirectional identity verification between websites and social profiles</li>
      <li><a href="https://schema.org/Organization" target="_blank" rel="noopener noreferrer">Schema.org: Organization</a> &mdash; Structured data for organizations including sameAs social profile links</li>
      <li><a href="https://developer.mozilla.org/en-US/docs/Web/API/Navigator/share" target="_blank" rel="noopener noreferrer">MDN: Web Share API</a> &mdash; Browser-native sharing API documentation and browser support</li>
      <li><a href="https://support.google.com/youtube/answer/171780" target="_blank" rel="noopener noreferrer">YouTube: Privacy-Enhanced Mode</a> &mdash; youtube-nocookie.com embed domain documentation</li>
      <li><a href="https://web.dev/articles/embed-best-practices" target="_blank" rel="noopener noreferrer">web.dev: Best Practices for Embeds</a> &mdash; Performance and privacy best practices for third-party embeds</li>
      <li><a href="https://webfinger.net/" target="_blank" rel="noopener noreferrer">WebFinger Protocol</a> &mdash; Specification for fediverse/ActivityPub discovery from custom domains</li>
      <li><a href="https://ogp.me/" target="_blank" rel="noopener noreferrer">Open Graph Protocol</a> &mdash; The Open Graph protocol specification for social sharing metadata</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .category-nav a { padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); text-decoration: none; transition: all 0.15s; white-space: nowrap; }
  .category-nav a:hover { background: var(--color-accent-bg); color: var(--color-accent); text-decoration: none; }
  .category-heading { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; margin-bottom: 0.5rem; margin-top: 2rem; }
  .category-description { margin: 0 0 1.25rem; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; }
  .pattern-list { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
  .pattern-card { padding: 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface); overflow: hidden; }
  .pattern-card-inner { display: flex; gap: 1.25rem; align-items: flex-start; }
  .pattern-content { flex: 1; min-width: 0; }
  @media (max-width: 600px) { .pattern-card-inner { flex-direction: column; } }
  .pattern-name { font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; }
  .pattern-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0 0 0.75rem; }
  .pattern-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-block { font-size: 0.85rem; line-height: 1.5; }
  .meta-block p { margin: 0; color: var(--color-text-secondary); overflow-wrap: break-word; }
  .meta-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-right: 0.35rem; }
  .docs-link { display: inline-block; margin-top: 0.25rem; font-size: 0.82rem; font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .docs-link:hover { text-decoration: underline; }
  .tips-section { margin-top: 3rem; }
  .tips-table { width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.92rem; }
  .tips-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--color-surface); border-bottom: 2px solid var(--color-border); font-weight: 700; color: var(--color-text); }
  .tips-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); }
  .tips-table tr:last-child td { border-bottom: none; }
  .related-section { margin-top: 3rem; }
  .related-links { list-style: none; padding: 0; margin: 1rem 0 0; }
  .related-links li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .related-links li:last-child { border-bottom: none; }
  .related-links a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .related-links a:hover { text-decoration: underline; }
  .further-reading { margin-top: 3rem; }
  .further-reading ul { list-style: none; padding: 0; margin: 1rem 0 0; }
  .further-reading li { padding: 0.5rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 0.92rem; line-height: 1.6; }
  .further-reading li:last-child { border-bottom: none; }
  .further-reading a { font-weight: 600; color: var(--color-accent); text-decoration: none; }
  .further-reading a:hover { text-decoration: underline; }
</style>
