---
import DocsLayout from '../layouts/DocsLayout.astro';
import LegalPatternIllustration from '../components/patterns/LegalPatternIllustration.astro';
import { legalPatterns, categoryLabels, categoryOrder } from '../data/legal-patterns';
import type { LegalPattern } from '../data/legal-patterns';

// Group patterns by category
const grouped = categoryOrder.reduce((acc, cat) => {
  const items = legalPatterns.filter((p) => p.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {} as Record<string, typeof legalPatterns>);

const categories = Object.keys(grouped) as Array<keyof typeof categoryLabels>;

const categoryDescriptions: Record<LegalPattern['category'], string> = {
  pages: 'Mandatory legal pages that every commercial website in the EU/DACH region must provide — Impressum, privacy policy, and terms of service.',
  consent: 'Mechanisms for collecting, recording, and enforcing user consent before processing personal data or loading third-party scripts.',
  data: 'User rights under GDPR that your application must support — data access, portability, rectification, and erasure.',
  accessibility: 'Legal obligations for digital accessibility under the European Accessibility Act (EAA) and German BFSG, effective June 2025.',
  regional: 'Requirements specific to certain jurisdictions — DACH Impressum law, Swiss DSG, Austrian ECG, and sector-specific regulations.',
};
---

<DocsLayout title="Legal & Compliance" sectionLabel="Reference" activeSlug="legal-compliance">

  <h2>Legal & Compliance Patterns</h2>
  <p>Compliance patterns that VibeCrew agents enforce during planning and code review. Every pattern references the applicable regulation, documents the penalty for non-compliance, and provides actionable implementation guidance for DACH-region SaaS applications.</p>

  <nav class="category-nav" aria-label="Pattern categories">
    {categories.map((cat) => (
      <a href={`#cat-${cat}`}>{categoryLabels[cat]}</a>
    ))}
  </nav>

  {categories.map((cat) => (
    <section class="pattern-section" id={`cat-${cat}`}>
      <h3 class="category-heading">{categoryLabels[cat]}</h3>
      <p class="category-description">{categoryDescriptions[cat]}</p>
      <div class="pattern-list">
        {grouped[cat].map((entry) => (
          <div class="pattern-card" id={entry.name.toLowerCase().replace(/[\s\/()]/g, '-')}>
            <div class="pattern-card-inner">
              <LegalPatternIllustration name={entry.name} />
              <div class="pattern-content">
                <h4 class="pattern-name">{entry.name}</h4>
                <p class="pattern-desc">{entry.description}</p>
                <div class="pattern-meta">
                  <div class="meta-block">
                    <span class="meta-label">Legal Requirement</span>
                    <p>{entry.requirement}</p>
                  </div>
                  <div class="meta-block">
                    <span class="meta-label">Penalty</span>
                    <p>{entry.penalty}</p>
                  </div>
                  {entry.docsUrl && (
                    <a class="docs-link" href={entry.docsUrl} target="_blank" rel="noopener noreferrer">Docs →</a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="further-reading" id="further-reading">
    <h3 class="category-heading">Further Reading</h3>
    <ul>
      <li><a href="https://allaboutberlin.com/guides/website-impressum" target="_blank" rel="noopener noreferrer">allaboutberlin.com Impressum Guide</a> &mdash; Practical guide to creating a legally compliant Impressum for German websites</li>
      <li><a href="https://gdpr.eu/" target="_blank" rel="noopener noreferrer">GDPR.eu</a> &mdash; Comprehensive GDPR resource with guides, checklists, and regulation text</li>
      <li><a href="https://ec.europa.eu/social/main.jsp?catId=1202" target="_blank" rel="noopener noreferrer">European Accessibility Act Guide</a> &mdash; Official EU resource on the European Accessibility Act requirements</li>
      <li><a href="https://www.w3.org/WAI/planning/statements/generator/" target="_blank" rel="noopener noreferrer">W3C Accessibility Statement Generator</a> &mdash; Tool for generating WCAG-compliant accessibility statements</li>
    </ul>
  </section>

</DocsLayout>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .category-nav a {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .category-nav a:hover {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    text-decoration: none;
  }

  .category-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    margin-top: 2rem;
  }

  .category-description {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .pattern-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .pattern-card {
    padding: 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .pattern-card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .pattern-content {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 600px) {
    .pattern-card-inner {
      flex-direction: column;
    }
  }

  .pattern-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .pattern-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .pattern-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-block {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-block p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .meta-label {
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-right: 0.35rem;
  }

  .docs-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .docs-link:hover {
    text-decoration: underline;
  }

  .further-reading {
    margin-top: 3rem;
  }

  .further-reading ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .further-reading li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .further-reading li:last-child {
    border-bottom: none;
  }

  .further-reading a {
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .further-reading a:hover {
    text-decoration: underline;
  }
</style>
