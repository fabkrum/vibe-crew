---
interface Props {
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
---

<div class="mermaid-container">
  <pre class="mermaid">{chart}</pre>
  {caption && <p class="mermaid-caption">{caption}</p>}
  <noscript>
    <pre><code>{chart}</code></pre>
  </noscript>
</div>

<style>
  .mermaid-container {
    margin-bottom: 2rem;
  }
  pre.mermaid {
    background: transparent;
    border: none;
    padding: 0;
    text-align: center;
  }
  .mermaid-caption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
</style>

<script is:inline>
  (function() {
    if (document.querySelector('.mermaid') && !window.__mermaidLoaded) {
      window.__mermaidLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      s.onload = function() {
        mermaid.initialize({
          startOnLoad: true,
          theme: 'dark',
          themeVariables: {
            primaryColor: '#7c3aed',
            primaryTextColor: '#fafafa',
            primaryBorderColor: '#a78bfa',
            lineColor: '#a78bfa',
            secondaryColor: '#18181b',
            tertiaryColor: '#111113',
            background: '#0a0a0b',
            mainBkg: '#18181b',
            nodeBorder: '#a78bfa',
            clusterBkg: '#111113',
            clusterBorder: '#27272a',
            titleColor: '#fafafa',
            edgeLabelBackground: '#18181b',
          },
        });
      };
      document.head.appendChild(s);
    }
  })();
</script>
